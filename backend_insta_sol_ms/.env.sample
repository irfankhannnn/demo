# Instagram Solution backend microservice — environment reference.
#
# Copy to one of these (all gitignored — never commit a filled copy):
#   .env.local  local development: `npm run dev`
#   .env.dev    deployed dev stack: `./infra/deploy.sh dev`
#   .env.prod   deployed prod stack: `./infra/deploy.sh prod`

# ---------------------------------------------------------------------------
# Required — config/env.js refuses to boot without these.
# ---------------------------------------------------------------------------

# Auth microservice, reached as https://<DOMAIN_NAME>/<BASE_PATH>. Browser JWTs
# are validated by GET <that>/auth/me, exactly as the CRM does.
# DOMAIN_NAME is the API Gateway custom domain (bare hostname); raw API Gateway
# invoke hosts are rejected at boot. A full origin such as http://localhost:4000
# is accepted for local development only, with BASE_PATH left empty.
#   dev : services-api.cloudberrysolutions.in + devrealestateauth
#   prod: services-api.realestateflow.in      + prodrealestateauth
AUTH_SERVICE_DOMAIN_NAME=services-api.example.com
AUTH_SERVICE_BASE_PATH=devrealestateauth

# DynamoDB single tables. Env-first naming: <env>-realestateflow-insta-<resource>.
# Not needed when INSTA_STORE=memory.
INSTA_DATA_TABLE_NAME=dev-realestateflow-insta-data
INSTA_AUDIT_TABLE_NAME=dev-realestateflow-insta-audit

# ---------------------------------------------------------------------------
# Instagram app  <-- THE APP ID AND SECRET GO HERE
# ---------------------------------------------------------------------------
# developers.facebook.com -> your app -> Instagram -> API setup with Instagram
# business login. Use the INSTAGRAM App ID / App Secret shown on that page, not
# the Facebook App ID on the app's Basic settings page.
META_APP_ID=
META_APP_SECRET=

# Any long random string. Paste the same value into the Meta app's webhook
# "Verify token" field. Generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=

# Encrypts stored Instagram access tokens (AES-256-GCM). 64 hex characters.
# Generate once per environment with: openssl rand -hex 32
# Changing it later makes every connected account reconnect.
INSTA_TOKEN_ENCRYPTION_KEY=

# This API's public URL = https://<DOMAIN_NAME>/<BASE_PATH>. The OAuth redirect
# URI is derived from it and must be registered in the Meta app exactly:
#   <that URL>/api/insta/oauth/callback
#   dev : services-api.cloudberrysolutions.in + devrealestateinsta
#   prod: services-api.realestateflow.in      + prodrealestateinsta
#   local: http://localhost:3101 + (empty)
INSTA_API_DOMAIN_NAME=services-api.example.com
INSTA_API_BASE_PATH=devrealestateinsta

# Optional override when the redirect must differ from the derived one (for
# example an https tunnel to a local backend).
META_REDIRECT_URI=

# The console (frontend_insta_sol_ms). After connecting, the browser lands on
# <INSTA_CONSOLE_URL>/accounts. No trailing slash.
INSTA_CONSOLE_URL=http://localhost:3100/insta

# ---------------------------------------------------------------------------
# Lead analysis (pluggable)
# ---------------------------------------------------------------------------
# rules  = deterministic, free, offline (default when no key is set)
# gemini = used automatically when GEMINI_API_KEY is set
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Sending safety
# ---------------------------------------------------------------------------
# true = replies and keyword-rule DMs are checked and recorded but never sent
# to Instagram. Start every new environment with true.
INSTA_DRY_RUN_SENDS=true
# Keyword rules (comment -> public reply + private DM).
INSTA_RULES_ENABLED=true
# Ceiling on automatic rule replies per Instagram account per hour.
INSTA_MAX_AUTO_REPLIES_PER_HOUR=30
# true stops every send immediately (console replies and rules). Reads continue.
INSTA_KILL_SWITCH=false

# ---------------------------------------------------------------------------
# Worker cadence (minutes). The worker runs from EventBridge in AWS, and on a
# timer inside `npm run dev` locally (INSTA_LOCAL_WORKER_SECONDS).
# ---------------------------------------------------------------------------
INSTA_POLL_CONVERSATIONS_MINUTES=5
INSTA_POLL_COMMENTS_MINUTES=5
INSTA_POLL_MEDIA_MINUTES=60
INSTA_POLL_PROFILE_MINUTES=360
INSTA_ANALYSIS_BATCH=10
INSTA_WORKER_TIME_BUDGET_MS=50000
INSTA_LOCAL_WORKER_SECONDS=0

# ---------------------------------------------------------------------------
# CRM lead-pipeline bridge
# ---------------------------------------------------------------------------
# Qualified enquiries (name + phone + buy/rent/sell intent) are forwarded to
# https://<DOMAIN_NAME>/<BASE_PATH>/api/internal/adapters/leads.
# Leave the domain and key blank to run standalone.
#   dev : services-api.cloudberrysolutions.in + devrealestatecrm
#   prod: services-api.realestateflow.in      + prodrealestatecrm
CRM_INTERNAL_API_DOMAIN_NAME=
CRM_INTERNAL_API_BASE_PATH=
# MUST match the CRM stack's AdapterInternalApiKey. openssl rand -hex 32
ADAPTER_INTERNAL_API_KEY=
CRM_INTERNAL_TIMEOUT_MS=5000
INSTA_PROMOTE_ENQUIRIES_TO_LEADS=true

# ---------------------------------------------------------------------------
# Optional — sane defaults shown.
# ---------------------------------------------------------------------------
PORT=3101
AWS_REGION=ap-south-1
# Comma-separated CORS allowlist. Requests with no Origin (Meta webhooks, curl)
# are always allowed; a browser Origin must be on this list.
ALLOWED_ORIGINS=http://localhost:3100
LOG_LEVEL=info
NODE_ENV=development
REQUEST_BODY_LIMIT=2mb
AUTH_TOKEN_CACHE_TTL_MS=60000
AUTH_TOKEN_STALE_GRACE_MS=300000
AUTH_SERVICE_TIMEOUT_MS=3000
INSTA_AUDIT_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Local development only (refused under Lambda)
# ---------------------------------------------------------------------------
# memory = no AWS needed; data lives in this process (or INSTA_MEMORY_STORE_FILE).
INSTA_STORE=
INSTA_MEMORY_STORE_FILE=
# Skip CRM login: every request acts as this tenant. Never set outside a laptop.
INSTA_DEV_AUTH_TENANT_ID=

# ---------------------------------------------------------------------------
# Deploy-only — read by infra/deploy.sh / cfn-insta-sol-ms.yaml.
# ---------------------------------------------------------------------------
AWS_PROFILE=
STACK_NAME=dev-realestateflow-insta-stack
ARTIFACT_BUCKET=
ARTIFACT_PREFIX=insta-sol-ms
ENABLE_CUSTOM_DOMAIN_MAPPING=true
ENABLE_BASE_PATH_STRIP=true
# EventBridge schedule for the worker; set INSTA_WORKER_ENABLED=false to pause it.
INSTA_WORKER_SCHEDULE=rate(2 minutes)
INSTA_WORKER_ENABLED=true
