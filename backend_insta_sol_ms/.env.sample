# Instagram Solution backend microservice — environment reference.
#
# Copy to .env.dev / .env.prod (both gitignored; the infra agent owns those two
# files and the SSM parameters that populate them). Never commit a filled copy.

# ---------------------------------------------------------------------------
# Required — config/env.js refuses to boot without these.
# ---------------------------------------------------------------------------

# Auth microservice, reached as https://<DOMAIN_NAME>/<BASE_PATH>. Browser JWTs
# are validated by GET <that>/auth/me, exactly as the CRM's
# server/middleware/validateToken.js does. No shared code, same contract.
# DOMAIN_NAME is the API Gateway custom domain (bare hostname); raw API Gateway invoke
# hosts are rejected at boot. For local dev only, a full origin such as
# http://localhost:4000 is accepted, with BASE_PATH left empty.
#   dev : services-api.cloudberrysolutions.in + devrealestateauth
#   prod: services-api.realestateflow.in      + prodrealestateauth
AUTH_SERVICE_DOMAIN_NAME=services-api.example.com
AUTH_SERVICE_BASE_PATH=devrealestateauth

# DynamoDB single tables. Env-first naming: <env>-realestateflow-insta-<resource>.
INSTA_DATA_TABLE_NAME=dev-realestateflow-insta-data
INSTA_AUDIT_TABLE_NAME=dev-realestateflow-insta-audit

# ---------------------------------------------------------------------------
# Optional — sane defaults shown.
# ---------------------------------------------------------------------------

# Local listen port. Ignored under Lambda.
PORT=7318

AWS_REGION=ap-south-1

# Comma-separated CORS allowlist. Requests with no Origin (agent, curl, Lambda
# health probes) are always allowed; a browser Origin must be on this list.
ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=development

# Max JSON body. The agent uploads batches of up to 500 items per request.
REQUEST_BODY_LIMIT=2mb

# --- JWT validation cache (mirrors the CRM's tuning knobs) ---
# How long a successful /auth/me result is trusted without re-asking.
AUTH_TOKEN_CACHE_TTL_MS=60000
# Extra window during which an expired cache entry is still honoured, but only
# while the auth service is unreachable. Keeps the dashboard alive in an outage.
AUTH_TOKEN_STALE_GRACE_MS=300000
AUTH_SERVICE_TIMEOUT_MS=3000

# --- HMAC device auth (laptop agent) ---
# Rejection threshold for clock skew between the agent laptop and the API.
# Contract section 2b fixes this at 5 minutes; do not raise it.
INSTA_HMAC_MAX_SKEW_MS=300000
# How long a used nonce is remembered in the audit table. Must exceed the skew
# window, or a request could be replayed after its nonce record has expired.
INSTA_NONCE_TTL_SECONDS=900

# --- Pairing ---
# Pairing code lifetime, minutes. Contract section 2b: 15 minutes, single use.
INSTA_PAIRING_CODE_TTL_MINUTES=15

# --- Operational ---
# Flip to "true" to tell every paired agent to stop collecting on its next
# heartbeat. Cheaper and faster than revoking devices one by one.
INSTA_KILL_SWITCH=false

# Per-request cap on batched agent uploads (contract section 4: max 500).
INSTA_MAX_BATCH_ITEMS=500

# How many days of audit events to retain.
INSTA_AUDIT_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Deploy-only — read by infra/deploy.sh / cfn-insta-sol-ms.yaml, NOT by
# config/env.js. INSTA_API_BASE_PATH and ENABLE_BASE_PATH_STRIP are also read
# directly by lambda.js at runtime (set via the CFN template's Environment,
# not loaded from this file when running under Lambda).
# ---------------------------------------------------------------------------

# Custom domain already registered in API Gateway to map this API's base path
# onto. services-api.realestateflow.in for prod, services-api.cloudberrysolutions.in
# for dev/nonprod.
INSTA_API_DOMAIN_NAME=services-api.example.com

# Base path segment for this API on that custom domain:
# devrealestateinsta (dev) / prodrealestateinsta (prod).
INSTA_API_BASE_PATH=devrealestateinsta

# true in dev and prod — the stack creates the BasePathMapping. The API has no
# other supported public URL.
ENABLE_CUSTOM_DOMAIN_MAPPING=true

# true together with ENABLE_CUSTOM_DOMAIN_MAPPING — API Gateway does not strip
# the base path from the Lambda proxy event, so lambda.js does it.
ENABLE_BASE_PATH_STRIP=true

# ---------------------------------------------------------------------------
# CRM lead-pipeline bridge
# ---------------------------------------------------------------------------
# Captured Instagram enquiries are forwarded to the CRM so they become leads in
# the one CRM leads table and get the same treatment as every other source
# (AI qualification call, scoring, closure). See services/crmBridge.js.
#
# Leave CRM_INTERNAL_API_DOMAIN_NAME and ADAPTER_INTERNAL_API_KEY blank to run
# the Instagram feature standalone — enquiries are then stored locally only and
# never promoted. (deploy.sh requires both for dev/prod.)

# CRM API custom domain + base path. crmBridge.js calls
# https://<DOMAIN_NAME>/<BASE_PATH>/api/internal/adapters/leads.
#   dev : services-api.cloudberrysolutions.in + devrealestatecrm
#   prod: services-api.realestateflow.in      + prodrealestatecrm
CRM_INTERNAL_API_DOMAIN_NAME=
CRM_INTERNAL_API_BASE_PATH=

# Shared secret sent as x-api-key. MUST match the CRM stack's
# AdapterInternalApiKey parameter. Generate with:
#   openssl rand -hex 32
ADAPTER_INTERNAL_API_KEY=

# Timeout for each forward call, milliseconds.
CRM_INTERNAL_TIMEOUT_MS=5000

# Kill switch — set false to stop promoting enquiries without clearing creds.
INSTA_PROMOTE_ENQUIRIES_TO_LEADS=true
