# property-pages-ms — PROD template. Copy to .env.prod and fill in.
# Prod deploys to cloudberry-prod-new (532404260898). NOTE: that account is
# not verified for CloudFront — set ENABLE_CLOUDFRONT=false there until AWS
# Support clears it, or the stack will fail on the distribution.
#
# Copy to .env.dev / .env.prod and fill in. Deploy scripts read .env.<env>;
# nothing here is committed with a real value.
#
# Values marked REQUIRED are checked at cold start by config/env.js — the
# Lambda fails its first invocation with a readable message if any is missing,
# rather than serving broken pages.

NODE_ENV=production
AWS_REGION=ap-south-1
PORT=3005
LOG_LEVEL=info

# ── CRM internal API (REQUIRED) ───────────────────────────────────────────
# The ONLY route this service has to CRM data. Must include the full path
# prefix, no trailing slash.
#   dev:  https://services-api.cloudberrysolutions.in/devrealestatecrm/api/internal/public-pages
CRM_INTERNAL_API_URL=
# Must equal server/.env.<env>'s PUBLIC_PAGES_INTERNAL_API_KEY exactly.
# Generate with: openssl rand -hex 32
PUBLIC_PAGES_INTERNAL_API_KEY=
CRM_TIMEOUT_MS=6000

# ── Addressing ────────────────────────────────────────────────────────────
# Tenants are addressed as <agency-slug>.<PUBLIC_PAGES_BASE_DOMAIN>.
# Leave blank until the wildcard DNS record and ACM certificate are live; the
# path fallback below keeps everything reachable in the meantime.
PUBLIC_PAGES_BASE_DOMAIN=
# Serves the same pages at /t/<agency-slug>/... so the service is testable on a
# raw CloudFront URL before DNS is wired. Safe to leave on: it resolves the
# same tenant through the same lookup, it is not a bypass of anything.
PATH_TENANT_FALLBACK=true

# API Gateway custom-domain base path. Only set alongside
# ENABLE_BASE_PATH_STRIP=true, once a base-path mapping actually exists.
PAGES_API_BASE_PATH=
ENABLE_BASE_PATH_STRIP=false

# ── Abuse controls ────────────────────────────────────────────────────────
# DynamoDB table holding rate-limit counters and single-use booking nonces.
# Created by infra/cfn-property-pages.yaml. (REQUIRED)
GUARD_TABLE_NAME=

# Signs booking session tokens. MUST be at least 32 chars, and MUST NOT be
# reused from the CRM's JWT_SECRET — these tokens are handed to anonymous
# visitors. (REQUIRED)
# Generate with: openssl rand -hex 32
VISIT_SESSION_SECRET=

# How long a rendered booking form stays valid.
VISIT_SESSION_TTL_SECONDS=1800
# A form submitted faster than this was not typed by a person. Set 0 to disable.
VISIT_MIN_FILL_SECONDS=3

# Session mints per IP per burst window — the "many sessions from one IP in a
# second" control. Booking requires a session, so this caps attempts upstream
# of any write.
LIMIT_IP_BURST=5
LIMIT_IP_BURST_WINDOW_SECONDS=10
LIMIT_IP_HOURLY=40

# Completed bookings, deliberately much tighter than page views.
LIMIT_IP_BOOKINGS_DAILY=6
LIMIT_PHONE_BOOKINGS_DAILY=3
# The backstop on AI-qualification spend: every booking creates a lead, and a
# lead can trigger a billable AI call. This bounds a tenant's worst-case daily
# exposure to an attack.
LIMIT_TENANT_BOOKINGS_DAILY=200

# Failed attempts from one IP before a captcha is demanded.
LIMIT_CAPTCHA_TRIGGER=3

# Forces the in-memory counter store. Local development only — counters become
# per-process and are useless as a real limit. Never set this in a deployed
# environment.
# GUARD_STORE=memory

# ── Captcha (optional, but set BOTH or NEITHER) ───────────────────────────
# Shown only after an IP trips LIMIT_CAPTCHA_TRIGGER, so ordinary visitors
# never see it. Reuse the same hCaptcha keys as server/.env.<env>.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_VERIFY_TIMEOUT_MS=5000

# ── Presentation (optional) ───────────────────────────────────────────────
# Google Maps Embed API key. Without it, listings with coordinates show a
# text location plus a link out instead of an inline map.
GOOGLE_MAPS_EMBED_API_KEY=

# CDN cache lifetimes. Asset redirects must stay well under the 15-minute
# presigned URL lifetime or cached redirects will outlive their signatures.
ASSET_CACHE_SECONDS=300
PAGE_CACHE_SECONDS=60

# ── Deploy-time only (read by infra/deploy.sh, not by the app) ────────────
SERVICE_NAME=realestateflow-pages
STACK_NAME=prod-realestateflow-pages-stack
ARTIFACT_BUCKET=prod-realestateflow-artifacts
ARTIFACT_PREFIX=prod-realestateflow/property-pages-ms
API_STAGE_NAME=v1
ENABLE_CLOUDFRONT=false
ARTIFACT_BUCKET=
AWS_PROFILE=cloudberry-prod-new
