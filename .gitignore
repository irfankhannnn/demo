# Personal terminal/session launcher (local machine only, not shared)
#tools/kalim-sessions/

# Playwright artifacts (when run from root before config was moved)
test-results/

# Root-level node_modules (should never exist; tests/playwright has its own)
node_modules/

# Graphify generated output (local cache; regenerate with `graphify update .`)
graphify-out/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# Auto-generated deployment files (regenerated fresh by deploy.sh from
# .env.<env> on every run — carry real secrets, unlike the *.sample.json
# checked-in templates)
agency-app/api/infra/cfn-params.json
infra/cicd/**/cfn-params.json

# Environment files (contain secrets — never commit real .env files)
# .env.sample files are committed as templates; .env and .env.production are local/deploy secrets.
.env
.env.local
.env.production
agency-app/api/.env
agency-app/api/.env.production
# Server runtime logs (LLM traces, jsonl, etc.)
agency-app/api/logs/*
!agency-app/api/logs/.gitkeep
agency-app/web/.env
agency-app/web/.env.production
platform/whatsapp-platform/.env
platform/whatsapp-platform/.env.production
platform/auth/.env
platform/mcp/.env
agency-app/landing-pages/.env
tests/playwright/.env

# Local AWS/Lambda env dumps (use .env / .env.production instead)
env-update.json
**/crm-env*.json
**/whatsapp-*env.json
**/env-compact.json

# CI/CD local build/release history (per-machine deploy log + instant-access
# template/param snapshots). S3 (versioned) is the durable source of truth
# for the actual artifacts — this is never checked in. See the .gitignore
# best-practices section in the root README.md, and
# infra/cicd/*/README.md for the deploy-versions/ design.
infra/cicd/*/*/deploy-versions/
infra/cicd/*/*/config-versions/


# ---------------------------------------------------------------------------
# Instagram Solution (branch: instagram-solution)
# ---------------------------------------------------------------------------
# A plain ".env" line does NOT match ".env.dev"/".env.prod" - both patterns are
# required, with an explicit exception for the committed sample templates.
agency-app/instagram-api/.env
agency-app/instagram-api/.env.*
!agency-app/instagram-api/.env.sample
agency-app/instagram-web/.env
agency-app/instagram-web/.env.*
!agency-app/instagram-web/.env.sample
instagram-local-agent/.env
instagram-local-agent/.env.*
!instagram-local-agent/.env.sample

# Build artifacts, regenerated on every deploy - never hand-edited, never committed
agency-app/instagram-api/infra/cfn-params.json
agency-app/instagram-api/infra/.last-deploy-artifacts.json
agency-app/instagram-api/infra/.last-config-diff.json
agency-app/instagram-api/infra/.last-config-params.json
agency-app/instagram-api/function.zip
agency-app/instagram-web/infra/cfn-params.json
agency-app/instagram-web/infra/.last-deploy-artifacts.json
agency-app/instagram-web/infra/.last-config-diff.json
agency-app/instagram-web/dist/

# Local build/release index - S3 is the durable source of truth
infra/cicd/agency-app/instagram-api/deploy-versions/
infra/cicd/agency-app/instagram-api/config-versions/
infra/cicd/agency-app/instagram-web/deploy-versions/
infra/cicd/agency-app/instagram-web/config-versions/

# Laptop agent local state - SQLite DB, tokens, machine key. Never commit.
instagram-local-agent/.ig-agent/
instagram-local-agent/config/config.json
instagram-local-agent/config/rules.json

# Python bytecode
__pycache__/

# ---------------------------------------------------------------------------
# Pre-reorganisation folder names (backstop)
# ---------------------------------------------------------------------------
# The 2026-09-17 reorgs moved services first under apps/ + services/, then
# under platform/, public-app/ and agency-app/. Git moves tracked files, but
# local-only files (.env.<env>, deploy-versions/, config-versions/, auth_state/,
# node_modules/, dist/) stay behind in the old folders, and the old folder's
# own .gitignore goes away with it. These rules keep those leftovers out of a
# broad `git add` until tools/scripts/migrate-local-files.sh has moved them.
# Safe to delete once every machine has migrated.
/apps/
/services/
/real-estate-crm-app/
/server/
/frontend_insta_sol_ms/
/backend_insta_sol_ms/
/onboarding-page/
/landing-pages/
/property-pages-ms/
/reality-flow-authentication/
/reality-flow-mcp/
/whatsapp-platform/
/ai-calling-service/
/followup-agent-service/
/cfn-templates-cicd/
/kalim-sessions/
/claude-skills/
/huashu-design/
/openclaw_workspace_reference/
/videos/
