{
  "name": "RealtyFlow Design System",
  "version": "1.0.0",
  "description": "Design tokens for RealtyFlow brand - India & Dubai real estate platform",
  "colors": {
    "primary": "#0F172A",
    "primaryAlt": "#1E293B",
    "blue": "#2563EB",
    "blueLight": "#3B82F6",
    "blueLighter": "#60A5FA",
    "accent": "#22C55E",
    "accentLight": "#4ADE80",
    "accentLighter": "#86EFAC",
    "warning": "#EAB308",
    "warningLight": "#FACC15",
    "danger": "#EF4444",
    "dangerLight": "#F87171",
    "background": "#F8FAFC",
    "surface": "#FFFFFF",
    "surfaceSecondary": "#F1F5F9",
    "surfaceTertiary": "#E2E8F0",
    "border": "#E2E8F0",
    "borderDark": "#CBD5E1",
    "text": "#111827",
    "textSecondary": "#475569",
    "textTertiary": "#64748B",
    "overlay": "rgba(0, 0, 0, 0.5)",
    "overlayLight": "rgba(0, 0, 0, 0.2)"
  },
  "fonts": {
    "heading": {
      "family": "Poppins, sans-serif",
      "fallback": "system-ui, -apple-system, sans-serif"
    },
    "body": {
      "family": "Inter, sans-serif",
      "fallback": "system-ui, -apple-system, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono, monospace",
      "fallback": "Courier New, monospace"
    }
  },
  "typography": {
    "h1": {
      "size": "48px",
      "weight": 800,
      "lineHeight": 1.2,
      "letterSpacing": "-0.5px"
    },
    "h2": {
      "size": "32px",
      "weight": 700,
      "lineHeight": 1.3,
      "letterSpacing": "-0.25px"
    },
    "h3": {
      "size": "20px",
      "weight": 700,
      "lineHeight": 1.4
    },
    "h4": {
      "size": "18px",
      "weight": 600,
      "lineHeight": 1.4
    },
    "body": {
      "size": "16px",
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "size": "14px",
      "weight": 400,
      "lineHeight": 1.5
    },
    "tiny": {
      "size": "12px",
      "weight": 500,
      "lineHeight": 1.4
    }
  },
  "fontWeights": {
    "light": 300,
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px",
    "xxl": "80px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "full": "9999px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 2px 8px rgba(0, 0, 0, 0.04)",
    "md": "0 4px 16px rgba(0, 0, 0, 0.08)",
    "lg": "0 10px 30px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 50px rgba(0, 0, 0, 0.15)",
    "card": "0 10px 30px rgba(0, 0, 0, 0.05)"
  },
  "breakpoints": {
    "mobile": "0px",
    "tablet": "640px",
    "desktop": "1024px",
    "wide": "1280px",
    "ultrawide": "1536px"
  },
  "transitions": {
    "fast": "150ms ease-in-out",
    "standard": "300ms ease-in-out",
    "slow": "500ms ease-in-out"
  },
  "components": {
    "button": {
      "padding": "12px 20px",
      "borderRadius": "6px",
      "fontSize": "16px",
      "fontWeight": 600,
      "transitionDuration": "300ms"
    },
    "card": {
      "padding": "24px",
      "borderRadius": "10px",
      "boxShadow": "0 10px 30px rgba(0, 0, 0, 0.05)"
    },
    "input": {
      "padding": "12px 16px",
      "borderRadius": "6px",
      "borderColor": "#E2E8F0",
      "fontSize": "16px"
    }
  }
}
