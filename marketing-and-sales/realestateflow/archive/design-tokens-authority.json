  "designPrinciples": [
    "60% Whitespace Minimum - Every design should have significant breathing room",
    "Minimalist Approach - Remove unnecessary elements, focus on clarity",
    "Trust-First Design - RERA badge always visible, testimonials with names",
    "Direct Communication - Short, clear copy, no jargon, Hinglish-friendly"
  ],

  "messaging": {
    "tone": ["Direct", "Transparent", "Expert", "Approachable"],
    "keyMessages": [
      "Direct broker. Trustworthy. Established.",
      "20+ years of expertise. Personal attention. No middlemen.",
      "Professional branding for solo agents.",
      "Transparent process. Proven results."
    ],
    "hinglishExamples": [
      "Direct broker से बात करो। Sab kuch transparent।",
      "Apke dream property। Personal service। Expert guidance।",
      "RERA certified। 20+ years experience। Trust guaranteed।"
    ]
  },

  "trustSignals": {
    "rera": {
      "placement": "Header or top-left (always visible)",
      "format": "RERA #[License Number]",
      "importance": "NON-NEGOTIABLE"
    },
    "establishment": {
      "format": "Est. [Year]",
      "placement": "Near logo or header",
      "conveys": "Experience, longevity, stability"
    },
    "testimonials": {
      "includeNames": true,
      "includePhotos": true,
      "preferReal": true,
      "avoidAnonymous": true
    }
  },

  "cssVariables": {
    "colorPrimary": "#0F3A66",
    "colorSecondary": "#1E40AF",
    "colorAccent": "#22C55E",
    "colorBg": "#F8FAFC",
    "colorSurface": "#FFFFFF",
    "colorBorder": "#E2E8F0",
    "colorTextPrimary": "#111827",
    "colorTextSecondary": "#475569",
    "colorTextTertiary": "#64748B"
  },

  "fonts": {
    "googleFonts": "https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
