        "borderRadius": "4px",
        "fontWeight": "600",
        "hover": "#F8FAFC"
      },
      "success": {
        "background": "#22C55E",
        "text": "#FFFFFF",
        "padding": "12px 24px",
        "borderRadius": "4px",
