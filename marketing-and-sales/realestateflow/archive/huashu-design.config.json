{
  "name": "RealtyFlow Huashu Design Config",
  "version": "1.0.0",
  "description": "Huashu Design System configuration for RealtyFlow brand assets generation",
  "brand": {
    "name": "RealtyFlow",
    "markets": ["India", "Dubai"],
    "tagline": "Apne Real Estate Business Ko Next Level Le Jaao",
    "tonOfVoice": "Hinglish (70% English + 30% Hindi)",
    "audience": "Real estate agents, brokers, property developers"
  },
  "designLanguage": {
    "philosophy": "Modern minimal with bold accents, India-focused, growth-oriented",
    "keyCharacteristics": [
      "Clean and spacious layouts",
      "Professional yet approachable",
      "Action-oriented CTAs",
      "Authentic diversity representation",
      "Growth and upward momentum visuals"
    ]
  },
  "colorTokens": {
    "primary": {
      "value": "#0F172A",
      "name": "Dark Slate",
      "usage": "Headings, primary CTAs, main navigation"
    },
    "blue": {
      "value": "#2563EB",
      "name": "Brand Blue",
      "usage": "Interactive elements, links, highlights"
    },
    "accent": {
      "value": "#22C55E",
      "name": "Growth Green",
      "usage": "Success states, achievements, metrics"
    },
    "background": {
      "value": "#F8FAFC",
      "name": "Light Gray",
      "usage": "Page backgrounds, neutral sections"
    },
    "surface": {
      "value": "#FFFFFF",
      "name": "White",
      "usage": "Cards, containers, primary surfaces"
    },
    "text": {
      "value": "#111827",
      "name": "Dark Text",
      "usage": "Body text, paragraphs"
    },
    "textSecondary": {
      "value": "#475569",
      "name": "Gray Text",
      "usage": "Secondary text, descriptions"
    }
  },
  "typography": {
    "headingFont": {
      "name": "Poppins",
      "weights": [600, 700, 800],
      "usage": "All headlines and titles"
    },
    "bodyFont": {
      "name": "Inter",
      "weights": [400, 500, 600],
      "usage": "Body text, UI labels, descriptions"
    },
    "sizes": {
      "h1": "48px",
      "h2": "32px",
      "h3": "20px",
      "body": "16px",
      "small": "14px"
    }
  },
  "spacing": {
    "system": ["4px", "8px", "16px", "24px", "40px", "80px"],
    "cardPadding": "24px",
    "sectionGap": "40px to 80px",
    "componentGap": "8px to 16px"
  },
  "componentLibrary": {
    "buttons": [
      {
        "name": "Primary Button",
        "background": "#2563EB",
        "textColor": "white",
        "padding": "12px 20px",
        "borderRadius": "6px",
        "usage": "Main CTAs, primary actions"
      },
      {
        "name": "Secondary Button",
        "background": "#F1F5F9",
        "textColor": "#0F172A",
        "padding": "12px 20px",
        "borderRadius": "6px",
        "usage": "Alternative actions"
      },
      {
        "name": "Outline Button",
        "background": "transparent",
        "textColor": "#2563EB",
        "border": "2px solid #2563EB",
        "padding": "12px 20px",
        "borderRadius": "6px",
        "usage": "Tertiary actions"
      }
    ],
    "cards": [
      {
        "name": "Standard Card",
        "background": "#FFFFFF",
        "border": "1px solid #E2E8F0",
        "borderRadius": "10px",
        "padding": "24px",
        "shadow": "0 10px 30px rgba(0, 0, 0, 0.05)",
        "usage": "Feature cards, content blocks"
      }
    ],
    "metrics": [
      {
        "name": "Metric Box",
        "background": "#F8FAFC",
        "borderRadius": "10px",
        "padding": "16px",
        "usage": "Statistics, KPIs, numbers"
      }
    ]
  },
  "designDirections": {
    "modern_minimal": {
      "name": "Modern Minimal",
      "characteristics": "Clean lines, abundant whitespace, typography-focused",
      "colorPalette": ["#0F172A", "#FFFFFF", "#F8FAFC", "#2563EB"],
      "bestFor": "Landing pages, promotional materials, professional content"
    },
    "bold_vibrant": {
      "name": "Bold & Vibrant",
      "characteristics": "Strong color contrasts, dynamic layouts, energetic mood",
      "colorPalette": ["#0F172A", "#2563EB", "#22C55E", "#EAB308"],
      "bestFor": "Social media, ads, promotional posters"
    },
    "data_driven": {
      "name": "Data-Driven Design",
      "characteristics": "Infographics, metric-heavy, chart-focused, information architecture",
      "colorPalette": ["#0F172A", "#2563EB", "#22C55E", "#E2E8F0"],
      "bestFor": "Reports, case studies, performance dashboards"
    }
  },
  "outputFormats": {
    "webAssets": {
      "resolution": "1920x1080",
      "formats": ["PNG", "WebP", "SVG"],
      "optimization": "Compressed for web"
    },
    "socialMedia": {
      "instagram": {
        "post": "1080x1080px",
        "story": "1080x1920px",
        "reel": "1080x1920px"
      },
      "linkedin": "1200x627px",
      "twitter": "1024x512px"
    },
    "print": {
      "resolution": "300 DPI",
      "formats": ["PDF", "PNG"],
      "sizes": "A4, Letter, Custom"
    },
    "video": {
      "format": "MP4",
      "resolution": "1920x1080",
      "fps": 60,
      "codec": "H.264"
    }
  },
  "hinglishGuidelines": {
    "ratio": "70% English + 30% Hindi (romanized)",
    "tone": "Casual, friendly, action-oriented",
    "keyPhrases": [
      "Apna (your/ours) - builds ownership",
      "Easy ho gaya - simplification",
      "Next level - progress/growth",
      "Real agents, real deals - authenticity",
      "Ek jagah - one place consolidation"
    ],
    "examples": [
      "Apne deals ko track karo, clients ko manage karo, closing time karo!",
      "Ek platform mein sab kuch - properties, leads, follow-ups",
      "Real estate agents ke liye built, agents ke saath grow kiya"
    ]
  },
  "assetGenerationTriggers": {
    "landingPage": {
      "trigger": "Create interactive prototype",
      "output": "Interactive HTML + mobile frame",
      "time": "10-15 minutes",
      "components": ["Hero", "Features", "CTA", "Footer"]
    },
    "socialMedia": {
      "trigger": "Create social media creative set",
      "output": "PNG files (Instagram, LinkedIn sizes)",
      "time": "5-10 minutes",
      "variants": 3
    },
    "poster": {
      "trigger": "Design promotional poster",
      "output": "High-res PNG (1080x1920 for Instagram Story)",
      "time": "5 minutes",
      "variants": 2
    },
    "video": {
      "trigger": "Export MP4 promotional video",
      "output": "MP4 (60fps) + subtitle file",
      "time": "8-12 minutes",
      "duration": "15-30 seconds"
    },
    "designVariants": {
      "trigger": "Design variants",
      "output": "3+ parallel design directions",
      "time": "10 minutes",
      "directions": ["Modern Minimal", "Bold Vibrant", "Data-Driven"]
    }
  },
  "assetStoragePath": "/marketing-and-sales/realestateflow/assets/",
  "fileNamingConvention": {
    "pattern": "{type}_{variant}_{date}_{size}.{format}",
    "examples": [
      "poster_bold_2026-05-03_1080x1920.png",
      "social_minimal_2026-05-03_1080x1080.png",
      "landing_page_2026-05-03_1920x1080.html",
      "video_promo_2026-05-03_1920x1080.mp4"
    ]
  },
  "brandVoice": {
    "tagline": "Real Estate Ke Liye Built By Agents, For Agents",
    "missionStatement": "Empower Indian real estate agents with intelligent tools to track deals, manage leads, and close faster",
    "values": [
      "Authenticity - built with real agents, for real deals",
      "Simplicity - one platform, all tools",
      "Growth - track, improve, scale",
      "Trust - secure, reliable, transparent"
    ]
  },
  "lastUpdated": "2026-05-03",
  "status": "Production Ready v1.0"
}
