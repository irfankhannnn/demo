{
  "tokenProvider": "devmode",
  "meta": {
    "appId": "REPLACE_WITH_INSTAGRAM_APP_ID",
    "appSecret": "REPLACE_WITH_INSTAGRAM_APP_SECRET",
    "redirectUri": "http://localhost:7318/oauth/callback",
    "apiVersion": "v23.0",
    "scopes": [
      "instagram_business_basic",
      "instagram_business_manage_messages",
      "instagram_business_manage_comments",
      "instagram_business_content_publish"
    ]
  },
  "cloud": {
    "baseUrl": "REPLACE_WITH_INSTA_API_BASE_URL",
    "basePath": "/api/insta",
    "timeoutMs": 15000
  },
  "console": {
    "host": "127.0.0.1",
    "port": 7317
  },
  "sync": {
    "profileIntervalMinutes": 1440,
    "mediaIntervalMinutes": 240,
    "commentsIntervalMinutes": 5,
    "conversationsIntervalMinutes": 1,
    "uplinkIntervalMinutes": 15
  },
  "limits": {
    "graph_read": { "perHour": 200 },
    "dm_send": { "perHour": 200 },
    "private_reply": { "perHour": 150 },
    "comment_reply": { "perHour": 150 },
    "publish": { "perDay": 20 }
  },
  "killSwitch": false,
  "dryRun": false
}
