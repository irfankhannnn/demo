# OAuth Configuration for RealtyFlow MCP Server
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════════════════════════════
# JWT Secrets (for signing OAuth tokens)
# ═══════════════════════════════════════════════════════════════════════════════

# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_here

# Base URL for JWT issuer and OAuth callbacks
# Example: https://app.realtyflow.com
OAUTH_BASE_URL=https://app.realtyflow.com

# ═══════════════════════════════════════════════════════════════════════════════
# OAuth Provider Credentials (Anthropic / Claude)
# ═══════════════════════════════════════════════════════════════════════════════

# Register at: https://console.anthropic.com/
# Create a new "Custom Connector" or "MCP Connector"
# Set redirect URI to: https://app.realtyflow.com/oauth/callback
OAUTH_ANTHROPIC_CLIENT_ID=your_anthropic_client_id
OAUTH_ANTHROPIC_CLIENT_SECRET=your_anthropic_client_secret

# ═══════════════════════════════════════════════════════════════════════════════
# OAuth Provider Credentials (OpenAI / ChatGPT)
# ═══════════════════════════════════════════════════════════════════════════════

# Register at: https://platform.openai.com/
# Create a new "Custom App" or "MCP Integration"
# Set redirect URI to: https://app.realtyflow.com/oauth/callback
OAUTH_OPENAI_CLIENT_ID=your_openai_client_id
OAUTH_OPENAI_CLIENT_SECRET=your_openai_client_secret

# ═══════════════════════════════════════════════════════════════════════════════
# DynamoDB Table for OAuth Authorization Codes
# ═══════════════════════════════════════════════════════════════════════════════

# Table to store temporary authorization codes (10 minute expiry)
# Create with: aws dynamodb create-table --table-name realtyflow-oauth-codes ...
OAUTH_CODES_TABLE_NAME=realtyflow-oauth-codes

# ═══════════════════════════════════════════════════════════════════════════════
# Optional: Token Revocation List (for advanced security)
# ═══════════════════════════════════════════════════════════════════════════════

# Table to store revoked tokens (optional)
# OAUTH_REVOCATION_TABLE_NAME=realtyflow-oauth-revoked-tokens

# ═══════════════════════════════════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Generate JWT secrets:
#    openssl rand -base64 32
#    openssl rand -base64 32
#
# 2. Register OAuth applications:
#    - Anthropic: https://console.anthropic.com/
#    - OpenAI: https://platform.openai.com/
#
# 3. Set redirect URI in both OAuth apps:
#    https://app.realtyflow.com/oauth/callback
#
# 4. Create DynamoDB table for authorization codes:
#    aws dynamodb create-table \
#      --table-name realtyflow-oauth-codes \
#      --attribute-definitions AttributeName=code,AttributeType=S \
#      --key-schema AttributeName=code,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST \
#      --region ap-south-1
#
# 5. Enable TTL on expiresAt attribute:
#    aws dynamodb update-time-to-live \
#      --table-name realtyflow-oauth-codes \
#      --time-to-live-specification AttributeName=expiresAt,Enabled=true \
#      --region ap-south-1
