# Follow-up Agent Service — environment reference.
#
# Copy to .env.dev / .env.prod (both gitignored) and fill in. Never commit a
# filled copy. infra/deploy.sh reads .env.<env> and refuses to run if anything
# required is missing, so a half-filled file fails loudly rather than deploying
# a broken stack.
#
# Legend:
#   [SECRET]   real credential — generate or copy from the named place, never invent one
#   [DEPLOY]   supplied at deploy time from this file; the running app reads it
#              from the Lambda environment, never from here
#   [DEFAULT]  safe to leave as-is

# =============================================================================
# AWS / deploy target                                                  [DEPLOY]
# =============================================================================

AWS_REGION=ap-south-1

# dev  -> cloudberry-main       (account 730335176275)
# prod -> cloudberry-prod-new   (account 532404260898)
# deploy.sh prints the resolved account before doing anything.
AWS_PROFILE=cloudberry-main

# Env-first naming: <env>-realestateflow-<service>-<resource>. deploy.sh hard
# fails if these don't start with the right prefix for the environment.
STACK_NAME=dev-realestateflow-followup-stack

# One shared artifact bucket per environment, holding Lambda code AND templates.
ARTIFACT_BUCKET=dev-realestateflow-artifacts
ARTIFACT_PREFIX=followup

# =============================================================================
# Physical resource names                                              [DEPLOY]
# =============================================================================

FOLLOWUP_TABLE_NAME=dev-realestateflow-followup-data

# =============================================================================
# CRM integration (this service -> CRM)
# =============================================================================

# The CRM's internal API — lead snapshot, escalations, notes. Custom domain
# (host only, no scheme) + the CRM API's base path; /api/internal/followups/...
# is appended in code. Raw execute-api hosts are rejected by both deploy.sh and
# the service.
#   dev:  services-api.cloudberrysolutions.in + devrealestatecrm
#   prod: services-api.realestateflow.in      + prodrealestatecrm
CRM_INTERNAL_API_DOMAIN_NAME=
CRM_INTERNAL_API_BASE_PATH=

# [SECRET] Shared secret presented as x-api-key to the CRM's
# /api/internal/followups/* routes. MUST equal FOLLOWUP_INTERNAL_API_KEY in
# server/.env.<env> (the CRM template's FollowupInternalApiKey parameter).
# Generate with `openssl rand -hex 32`.
CRM_INTERNAL_API_KEY=

# =============================================================================
# ai-calling-service integration (this service -> ai-calling-service)
# =============================================================================

# ai-calling-service's custom domain + base path; /api/ai-calling/calls/start
# is appended in code.
#   dev:  services-api.cloudberrysolutions.in + devrealestateagencyai
#   prod: services-api.realestateflow.in      + prodrealestateagencyai
AI_CALLING_SERVICE_DOMAIN_NAME=
AI_CALLING_SERVICE_BASE_PATH=

# [SECRET] Presented as x-api-key on ai-calling-service's /api/ai-calling/*
# routes. MUST equal CRM_CALLER_API_KEY in ai-calling-service/.env.<env> —
# that service authenticates any holder of the key as a trusted caller and
# then trusts x-tenant-id, so this is a tenant-crossing credential: server-side
# only, never in a browser bundle.
AI_CALLING_CALLER_API_KEY=

# =============================================================================
# Inbound auth (CRM -> this service)
# =============================================================================

# [SECRET] Shared secret the CRM backend presents on /api/followup/* routes.
# MUST equal FOLLOWUP_CALLER_API_KEY in server/.env.<env>. Generate with
# `openssl rand -hex 32`. Distinct from CRM_INTERNAL_API_KEY (other direction).
CRM_CALLER_API_KEY=

# =============================================================================
# API surface
# =============================================================================

# [DEFAULT]
API_STAGE_NAME=v1

# Comma-separated CORS allowlist. Only the CRM backend calls this service, so
# this mostly matters for API Gateway's own 4XX/5XX responses.
ALLOWED_ORIGINS=http://localhost:3000,https://app.realestateflow.in

# Shared API Gateway custom domain. prod MUST be services-api.realestateflow.in
# and dev MUST be services-api.cloudberrysolutions.in — deploy.sh rejects the
# reverse. REQUIRED — there is no raw execute-api fallback.
FOLLOWUP_API_DOMAIN_NAME=

# Single base path segment on that domain (REQUIRED).
#   dev: devrealestatefollowup   prod: prodrealestatefollowup
FOLLOWUP_API_BASE_PATH=

# Must be true (deploy.sh and the template both enforce it).
ENABLE_CUSTOM_DOMAIN_MAPPING=true

# Must be true whenever ENABLE_CUSTOM_DOMAIN_MAPPING is true. API Gateway does
# not strip the base path from a Lambda proxy event, so lambda-api.js does it.
ENABLE_BASE_PATH_STRIP=true

# =============================================================================
# Scheduling policy                                                    [DEFAULT]
# =============================================================================

# How often the dispatcher Lambda wakes up to place due calls and run the
# stuck-call watchdog. EventBridge schedule expression.
DISPATCH_SCHEDULE_EXPRESSION=rate(5 minutes)

# Tenant-level overrides live in the CRM's AgencyConfig (followupMaxAttempts,
# followupRetryGapMinutes, followupPostVisitDelayMinutes, businessHours*,
# timezone). These are the fallbacks when a tenant has not set them.
DEFAULT_MAX_ATTEMPTS=2
DEFAULT_RETRY_GAP_MINUTES=45
DEFAULT_POST_VISIT_DELAY_MINUTES=120
DEFAULT_BUSINESS_HOURS_START=10:00
DEFAULT_BUSINESS_HOURS_END=19:00
DEFAULT_TIMEZONE=Asia/Kolkata

# A job stuck in "calling" longer than this (no terminal call event received)
# is counted as a failed attempt.
CALL_WATCHDOG_MINUTES=20

# =============================================================================
# Lambda tuning                                              [DEPLOY] [DEFAULT]
# =============================================================================

# nodejs20.x preinstalls the AWS SDK v3 client set this service needs.
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=30
WORKER_TIMEOUT=120

# =============================================================================
# Operations                                                          [DEFAULT]
# =============================================================================

# debug | info | warn | error
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Optional: existing SNS topic ARN for CloudWatch alarms (worker errors, DLQ
# depth). Blank disables the alarms. e.g. the CRM stack's
# <env>-realestateflow-alerts topic.
ALERTS_TOPIC_ARN=

# =============================================================================
# Local development only — ignored under Lambda
# =============================================================================

PORT=3004
