{
  "mcpServers": {
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "meta-ads": {
      "type": "http",
      "url": "https://mcp.facebook.com/ads"
    },
    "blotato": {
      "type": "http",
      "url": "https://mcp.blotato.com/sse"
    },
    "nabi-crm": {
      "type": "stdio",
      "command": "node",
      "args": ["server/mcp-server/index.js"],
      "env": {
        "MCP_TENANT_ID": "${MCP_TENANT_ID}",
        "CRM_DYNAMODB_TABLE_NAME": "${CRM_DYNAMODB_TABLE_NAME}"
      }
    },
    "git": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mseep/git-mcp-server"]
    }
  }
}