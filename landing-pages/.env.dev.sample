# =============================================================================
# RealEstateFlow Landing Pages — dev environment
# Copy to .env.dev and fill in real values.
#
# This file is read by TWO things:
#   1. `LP_ENV=dev node build/scripts/process-partials.js` (the ALL_CAPS
#      keys below) — injected as {{TOKEN}} into the built HTML at build time.
#      These are NOT runtime env vars; they become static strings in dist/.
#   2. `infra/deploy.sh dev` (AWS_REGION / SERVICE_NAME / FRONTEND_* keys)
#      for the S3 + CloudFront stack it deploys/updates.
#
# Every physical AWS resource cfn-landing-pages.yaml creates is named
# dev-realestateflow-landing-pages-<resource> (env first) — keep
# SERVICE_NAME set to realestateflow-landing-pages.
# =============================================================================

# --- Deploy (infra/deploy.sh dev) ---
AWS_REGION=ap-south-1
# ENV is NOT read from this file by deploy.sh — it's forced from the
# dev|prod argument you pass on the command line, so it can't drift.
SERVICE_NAME=realestateflow-landing-pages
# Optional — leave blank to default to ${ENV}-${SERVICE_NAME}
# (dev-realestateflow-landing-pages). Must be globally unique across all of S3.
FRONTEND_S3_BUCKET_NAME=
FRONTEND_PRICE_CLASS=PriceClass_200
# No dev domain exists for the LP site yet — leave blank to preview on the
# *.cloudfront.net URL. (cloudberrysolutions.in is this project's nonprod
# domain per convention — a subdomain there, e.g. lp-dev.cloudberrysolutions.in,
# is the natural choice if a dev domain is ever wired up.)
FRONTEND_CUSTOM_DOMAIN_NAME=
FRONTEND_INCLUDE_WWW_ALIAS=false
FRONTEND_ACM_CERTIFICATE_ARN=
FRONTEND_HOSTED_ZONE_ID=
FRONTEND_WAF_WEB_ACL_ARN=

# --- Build/release tracking (cfn-templates-cicd/landing-pages/deploy.sh) ---
ARTIFACT_BUCKET=dev-realestateflow-artifacts

# =============================================================================
# Build-time content tokens ({{TOKEN}} in the HTML) — same shape as
# landing-pages/.env.example, just environment-scoped.
#
# NOTE: _partials/head-analytics.hbs does not guard against a blank ID — an
# empty GA4_ID/META_PIXEL_ID/etc. still fires an init call with an empty
# value once the visitor grants that consent category, it isn't silently
# skipped. So reuse the same real IDs as prod here rather than leaving them
# blank, unless you're deliberately using separate dev-only analytics
# properties (recommended, so dev traffic doesn't pollute prod dashboards).
# =============================================================================

GA4_ID=G-XXXXXXXXXX
META_PIXEL_ID=XXXXXXXXXXXXXXXXXX
LINKEDIN_PARTNER_ID=XXXXXXX
HOTJAR_ID=XXXXXXX
# Hotjar snippet/script version — required alongside HOTJAR_ID by
# head-analytics.hbs's hj() init call (not in landing-pages/.env.example
# today; 6 is Hotjar's current tracking-code version).
HOTJAR_SV=6
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
POSTHOG_HOST=https://eu.i.posthog.com

# --- Contact / CTA placeholders ---
CAL_HANDLE=realestateflow/demo
WHATSAPP_NUMBER=919876543210
CONTACT_EMAIL=info@realestateflow.in

# --- Site URLs ---
APP_URL=https://app.realestateflow.in
# Filled in after the first `infra/deploy.sh dev` run, from the stack's
# WebsiteURL output (or set FRONTEND_CUSTOM_DOMAIN_NAME above first).
SITE_URL=
