# ============================================================
# RealityFlow MCP Microservice - Environment Config
# ============================================================

# --- AWS Region ---
AWS_REGION=ap-south-1

# --- Stack / Service ---
SERVICE_NAME=realtyflow-mcp
ENV=dev

# --- Logging ---
LOG_LEVEL=info

# --- JWT Secrets (shared with CRM backend for token validation) ---
JWT_SECRET=your-jwt-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-min-32-chars

# --- OAuth Base URL (local dev only — in production, CloudFormation auto-computes this) ---
OAUTH_BASE_URL=

# --- DynamoDB Tables ---
OAUTH_CODES_TABLE_NAME=realtyflow-oauth-codes
OAUTH_CONNECTIONS_TABLE=realtyflow-oauth-connections

# --- CRM Backend API (for tool execution via HTTP) ---
CRM_API_URL=https://your-crm-api-gateway-url.execute-api.ap-south-1.amazonaws.com/prod
CRM_API_INTERNAL_KEY=your-internal-api-key-for-crm-backend

# --- Cognito (for validating user tokens on /oauth/authorize) ---
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_SERVICE_URL=https://your-auth-service-url.execute-api.ap-south-1.amazonaws.com/dev

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.realtyflow.com

# --- Lambda Deployment ---
LAMBDA_PACKAGES_BUCKET_NAME=realtyflow-lambda-packages
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=60
LOG_RETENTION_IN_DAYS=30

# --- Domain (optional, for custom domain on API Gateway) ---
DOMAIN_NAME=

# --- Frontend URL (used for OAuth login redirect when no session code is present) ---
# For local dev, point to the running frontend. In production, CloudFormation sets FRONTEND_URL.
FRONTEND_URL=http://localhost:3000

# --- Local Dev ---
PORT=4001
# Rate limiting is auto-disabled when NODE_ENV is development/dev.
# RATE_LIMIT_DISABLED=false
# Local dev only: simulates API Gateway authorizer tenant. MUST be a real tenant in production.
MCP_TENANT_ID=your-local-dev-tenant-id
