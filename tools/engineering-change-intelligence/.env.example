# Engineering Change Intelligence - optional local settings
#
# Not auto-loaded. To use: copy to .env (gitignored), then from the repo root run
#   set -a; . tools/engineering-change-intelligence/.env; set +a
#
# GitHub access for --pr mode comes from the gh CLI: run `gh auth login` once.
# (The manual GitHub workflow passes GH_TOKEN itself; nothing to set here.)

# Base branch for --branch mode (default: main)
ECI_BASE_BRANCH=main

# Slack (optional, local opt-in). Only read by
#   scripts/post-to-slack.sh --send <report>
# Without --send nothing is posted, even when this is set.
# The webhook itself decides the channel and bot name.
# SLACK_PR_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
