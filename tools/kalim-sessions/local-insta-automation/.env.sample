# Copy this file to .env in the same folder and fill in the values.
# .env is gitignored. Never commit it, and never paste these values into a chat.

# ------------------------------------------------------------ which AI ------
# claude_cli  the Claude Code CLI on this machine, signed in with your Claude
#             subscription. No key to keep, nothing billed per call. A call
#             takes a few seconds longer because it starts a process.
# gemini      the Google API below. Faster per call, needs a key.
# Left blank, the CLI wins when `claude` is on PATH and Gemini otherwise.
AI_PROVIDER=claude_cli

# Optional. The model the CLI is asked for. Sonnet is the default because it
# both reads the screenshots and writes the replies well enough at a fraction
# of Opus. CLAUDE_VISION_MODEL overrides it for screenshot reading alone.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_VISION_MODEL=
# Full path to the claude executable, if it is not on PATH.
CLAUDE_BIN=
# Seconds one CLI call may take before the app gives up on it.
CLAUDE_TIMEOUT=240

# ---------------------------------------------------------------- Gemini ----
# Required when AI_PROVIDER=gemini. Key from aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave blank and the runner asks your key which models it can use,
# then picks the cheapest capable one, which is a Flash-tier model. The CRM
# backend itself runs gemini-2.5-flash, so leaving this blank usually lands on
# the same model the product already uses.
# See the real list with: python scripts/lead_desk_server.py --list-models
GEMINI_MODEL=

# ------------------------------------------------------------- CRM backend --
# CRM API via its API Gateway custom domain (host only, no scheme) + base path.
# The runner appends /api/crm/... and /api/internal/... itself. Raw
# execute-api URLs are rejected.
#   nonprod: services-api.cloudberrysolutions.in + devrealestatecrm
#   prod:    services-api.realestateflow.in      + prodrealestatecrm
# Leave the domain blank to use config/mock-properties.json instead.
CRM_API_DOMAIN_NAME=
CRM_API_BASE_PATH=

# Pick ONE of the three ways in below. The runner prefers them in this order.

# 1. INTERNAL, the embeddings path. Best results: this is the semantic search
#    that runs Bedrock Titan embeddings over DynamoDB vector search, the same
#    one the AI voice agent uses. Needs the service key and an explicit tenant.
#    The key is the backend's AI_CALLING_INTERNAL_API_KEY value.
#    Note: if the DynamoDB vector index was never created in this environment,
#    the backend returns an empty list rather than an error, so the runner
#    falls through to the filter search below before saying "no match".
CRM_INTERNAL_API_KEY=
CRM_TENANT_ID=

# 2. CRM, the exact-filter path. A Cognito ID token for a logged-in CRM user.
#    To get one: log into the nonprod CRM in Chrome, open DevTools, and copy
#    localStorage key "auth_id_token". These expire in about an hour, so this
#    is fine for a session of testing and not for leaving running.
CRM_AUTH_TOKEN=

# 3. PUBLIC, the tenant API key path. Reaches only the public listing
#    endpoints and returns no owner details. Keys are provisioned directly in
#    the TenantApiKeys table, there is no self-serve endpoint.
CRM_PUBLIC_API_KEY=

# Override only if your deployment moved the route.
CRM_PROPERTY_SEARCH_PATH=/api/crm/properties
CRM_TENANT_HEADER=x-tenant-id

# Force the mock inventory even when the above is filled in. Useful for demos.
USE_MOCK_PROPERTIES=false

# The lead desk refuses to display sample listings. If no live backend answers,
# the inventory lane says "no live inventory connected" and stays empty, rather
# than showing an invented flat next to a real conversation. Set this to true
# only for a demo with no real leads on screen.
ALLOW_SAMPLE_INVENTORY=false

# ------------------------------------------------------------------ Server --
PORT=8931

# ------------------------------------------------- property search API --
# The standalone search API in infra/. Deploy it and the app gets live vector
# results from an api key alone, instead of needing the CRM service key or an
# hour-lived Cognito token. Leave both blank and nothing changes: the runner
# falls back to the CRM paths above (and then to nothing, unless
# ALLOW_SAMPLE_INVENTORY is on).
# infra/deploy.ps1 prints the two lines to paste here.
PROPERTY_API_BASE=
PROPERTY_API_KEY=
