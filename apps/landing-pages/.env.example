# LP Build Environment Variables
# Copy this file to .env and fill in your real values before deploying.
# These are injected at BUILD TIME by the process-partials.js script.
# They are NOT runtime environment variables — they become static strings in the HTML.

# ─── Analytics IDs ───────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
GA4_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (numeric)
META_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# LinkedIn Insight Tag partner ID (numeric)
LINKEDIN_PARTNER_ID=XXXXXXX

# Hotjar site ID (numeric)
HOTJAR_ID=XXXXXXX

# PostHog project API key
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostHog host (EU: https://eu.i.posthog.com, US: https://app.posthog.com)
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Contact / CTA placeholders ──────────────────────────────────────────────
# Cal.com booking handle (e.g. zishan or realestateflow/demo)
CAL_HANDLE=realestateflow/demo

# WhatsApp Business number in international format without + (e.g. 919876543210)
WHATSAPP_NUMBER=919876543210

# Support / contact email
CONTACT_EMAIL=info@realestateflow.in

# ─── Site URLs ────────────────────────────────────────────────────────────────
# CRM app base URL (used for "Login" and "Start Trial" CTAs)
APP_URL=https://app.realestateflow.in

# LP site canonical base URL
SITE_URL=https://realestateflow.in
