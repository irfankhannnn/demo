# =============================================================================
# Onboarding Page — local env
# =============================================================================
# Copy to .env and fill in. This is a local-only tool (no deploy pipeline);
# it uses the AWS SDK default credential chain, same as server/.

AWS_REGION=ap-south-1
PORT=5055

# --- AWS credentials (leave both blank to use AWS_PROFILE / aws configure) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Target table ---
# DOUBLE-CHECK THIS — writing to the wrong environment's table is a real
# mistake. This is server's consolidated AgencyConfig table (single source of
# truth — see docs/proposals/agency-config-single-source/report.md), not the
# retired reality-flow-authentication-owned table:
#   prod-realestateflow-agencies
#   dev-realestateflow-agencies
AGENCY_CONFIG_DYNAMODB_TABLE_NAME=
