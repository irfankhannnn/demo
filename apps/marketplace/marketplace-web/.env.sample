# =============================================================================
# RealEstateFlow Homes (marketplace-web) — local dev
# Copy to .env.local (gitignored) for `npm run dev`.
# For a deploy, copy .env.dev.sample / .env.prod.sample instead.
# =============================================================================

VITE_SITE_NAME=RealEstateFlow Homes
VITE_PORT=5174

# marketplace-api (apps/marketplace/marketplace-api) — full origin, no trailing slash.
# Local: http://localhost:3006. Deployed: https://<MARKETPLACE_API_DOMAIN_NAME>/<MARKETPLACE_API_BASE_PATH>
VITE_MARKETPLACE_API_URL=http://localhost:3006

# marketplace-authentication (services/marketplace-authentication) — full origin.
# Local: http://localhost:3007. Deployed: https://<MARKETPLACE_AUTH_DOMAIN_NAME>/<MARKETPLACE_AUTH_BASE_PATH>
VITE_MARKETPLACE_AUTH_URL=http://localhost:3007

# Optional — Google Maps Embed API key. Blank hides the map on property pages.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Optional — reserved for the abuse guard on anonymous AI search. Blank = off.
VITE_HCAPTCHA_SITE_KEY=
