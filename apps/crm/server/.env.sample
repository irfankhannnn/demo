# =============================================================================
# RealtyFlow CRM Backend — Environment Template
# Copy to .env for local development. Copy to .env.dev / .env.prod for
# apps/crm/server/infra/deploy.sh (./infra/deploy.sh dev | ./infra/deploy.sh prod) —
# those two drive the CloudFormation parameters for the two deployed stacks.
# All files must use the same keys; only values change per environment.
#
# Every physical AWS resource apps/crm/server/infra/cfn-backend.yaml and
# apps/crm/server/infra/launch-tables-cfn.yaml create is named
# <dev|prod>-realestateflow-<resource> (env first), taken from the
# *_TABLE_NAME / *_TABLE / STACK_NAME / ARTIFACT_PREFIX / S3_BUCKET_NAME
# values below. Keep that ordering when you fill these in for a new
# environment.
# =============================================================================

# --- Server basics ---
PORT=3001
NODE_ENV=development
AWS_REGION=ap-south-1
LOG_LEVEL=info
# Web origins only. The Capacitor WebView origins (capacitor://localhost for
# iOS, https://localhost for Android) are appended automatically in
# utils/corsOrigins.js — do not add them here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_MAX_AGE_SECONDS=86400
REQUEST_BODY_LIMIT=1mb
# Strips PUBLIC_API_BASE_PATH / CRM_API_BASE_PATH only when the request path starts with it (safe locally).
ENABLE_BASE_PATH_STRIP=true

# --- Platform operators ---
PLATFORM_OPERATOR_USER_IDS=
PLATFORM_OPERATOR_EMAILS=

# --- CloudFormation / deployment ---
ENVIRONMENT_NAME=dev
STACK_NAME=dev-realestateflow-backend
# Created by infra/cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment for both Lambda code and
# oversized/nested CFN templates. Must match <env>-realestateflow-artifacts
# for the same EnvironmentName.
ARTIFACT_BUCKET=dev-realestateflow-artifacts
ARTIFACT_PREFIX=dev-realestateflow
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=300

# --- DynamoDB tables ---
DYNAMODB_TABLE_NAME=dev-realestateflow-core
CRM_DYNAMODB_TABLE_NAME=dev-realestateflow-crm
AGENCY_CONFIG_DYNAMODB_TABLE_NAME=dev-realestateflow-agencies
# Derived policy-document chunks + embeddings (apps/crm/server/services/knowledge/).
KNOWLEDGE_CHUNKS_DYNAMODB_TABLE_NAME=
ENQUIRIES_DYNAMODB_TABLE_NAME=dev-realestateflow-enquiries
AREAS_DYNAMODB_TABLE_NAME=dev-realestateflow-areas
B2B_LEADS_TABLE=dev-realestateflow-b2b-details
KHATA_TABLE_NAME=dev-realestateflow-khata
NOTIFICATIONS_TABLE_NAME=dev-realestateflow-notifications
DEVELOPERS_TABLE_NAME=dev-realestateflow-developers
REAL_ESTATE_AREAS_TABLE_NAME=dev-realestateflow-communities
PROJECTS_TABLE_NAME=dev-realestateflow-projects
CREDITS_TABLE_NAME=dev-realestateflow-credits
CREDIT_CONFIG_TABLE_NAME=dev-realestateflow-credit-config
USER_CATEGORIES_TABLE_NAME=dev-realestateflow-user-categories
# Device push tokens for the mobile apps (tenant + user scoped, TTL-pruned)
PUSH_TOKENS_TABLE=dev-realestateflow-push-tokens

# --- Operational tables ---
# These five are created by apps/crm/server/infra/launch-tables-cfn.yaml, not this
# stack — the values here must match what that stack names them for the
# same EnvironmentName.
SUBSCRIPTIONS_TABLE=dev-realestateflow-subscriptions
NPS_TABLE=dev-realestateflow-nps-responses
NPS_HMAC_SECRET=your-nps-hmac-secret
WEBHOOK_LOG_TABLE=dev-realestateflow-webhook-log
AI_EMPLOYEE_PROVISIONING_TABLE=dev-realestateflow-ai-employee-provisioning
TENANT_API_KEYS_TABLE=dev-realestateflow-tenant-api-keys
TENANT_API_KEYS_HASH_INDEX=keyHash-index
GRIEVANCES_TABLE_NAME=dev-realestateflow-grievances
AGENT_AUDIT_TABLE_NAME=dev-realestateflow-agent-audit

# --- S3 / local DynamoDB ---
# Must be globally unique across ALL AWS accounts, not just this one.
S3_BUCKET_NAME=dev-realestateflow-documents
DYNAMODB_ENDPOINT=

# --- API Gateway custom domains ---
PUBLIC_API_DOMAIN_NAME=your-public-api-domain
PUBLIC_API_BASE_PATH=your-public-base-path
PUBLIC_API_STAGE_NAME=dev
CRM_API_DOMAIN_NAME=your-crm-api-domain
CRM_API_BASE_PATH=your-crm-base-path
CRM_API_STAGE_NAME=dev
# true once the custom domain exists (deploy.sh then requires ENABLE_BASE_PATH_STRIP=true)
ENABLE_CUSTOM_DOMAIN_MAPPING=true

# --- Auth microservice ---
# Reached via the API Gateway custom domain + base path mapping, never a raw
# execute-api URL. Composed by config/serviceUrls.js; route suffixes
# (/auth/me, /internal/users/list, /users) are appended in code.
# Bare host only (no https://, never an execute-api host); base path is one segment.
AUTH_SERVICE_DOMAIN_NAME=your-api-custom-domain
AUTH_SERVICE_BASE_PATH=your-auth-base-path
INTERNAL_API_KEY=your-internal-api-key
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# --- Billing / Razorpay ---
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_AI_EMPLOYEE=your-razorpay-ai-employee-plan

# --- Email (Brevo + SES) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=no-reply@yourdomain.com
BREVO_FROM_NAME=YourAppName
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_PAYMENT_FAILED_TEMPLATE_ID=your-template-id
BREVO_TRIAL_LIST_ID=your-list-id
BREVO_AI_EMPLOYEE_PAID_TEMPLATE_ID=your-template-id
BREVO_AI_EMPLOYEE_ESCALATED_FOUNDER_TEMPLATE_ID=your-template-id
BREVO_AI_EMPLOYEE_ESCALATED_CUSTOMER_TEMPLATE_ID=your-template-id
BREVO_ESCALATED_TEMPLATE_ID=your-template-id
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
EMAIL_PROVIDER_PRIMARY=ses
EMAIL_PROVIDER_FALLBACK=brevo

# --- Founder / support ---
FOUNDER_EMAIL=info@yourdomain.com
FOUNDER_NOTIFICATION_EMAIL=info@yourdomain.com
FOUNDER_WHATSAPP=

# --- hCaptcha ---
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret

# --- Analytics / observability ---
POSTHOG_KEY_SERVER=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN_SERVER=
SENTRY_ENV=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
CLOUDWATCH_METRICS_ENABLED=true

# --- Bailey WhatsApp (whatsapp-platform) ---
BAILEY_ENABLED=false
BAILEY_MODE=selfhosted
BAILEY_API_KEY=your-bailey-api-key
BAILEY_ADMIN_API_KEY=your-bailey-admin-key
BAILEY_WEBHOOK_SECRET=your-bailey-webhook-secret
BAILEY_API_ENDPOINT=http://localhost:3003
BAILEY_API_PREFIX=/v1

# --- Push notifications (Firebase Cloud Messaging, HTTP v1) ---
# FCM relays to APNs for iOS, so one credential covers both stores.
# Leave BOTH of these unset and push is a logged no-op: device tokens are still
# accepted and stored, nothing is sent, and in-app notifications are unaffected.
# Supply exactly one:
#   FIREBASE_SERVICE_ACCOUNT_JSON  — the whole service-account key as a single-
#                                    line JSON string. Preferred on Lambda,
#                                    which has no writable place for a file.
#   GOOGLE_APPLICATION_CREDENTIALS — absolute path to that key file. Easier
#                                    locally; never commit the file.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI agents ---
AGENTS_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CLASSIFIER_MODEL=gemini-3.1-flash-lite
GEMINI_FILE_LOG=false
AGENT_TRUNCATE_LIST_LIMIT=3
AGENT_TRUNCATE_MAX_RESULT_CHARS=2000
AGENT_TRUNCATE_STRING_LENGTH=100
# Bounded multi-step tool loop (Phase 3). OFF = the original single-shot
# planner (one tool call per turn). Turn on to let one turn complete a
# compound request ("create a lead AND schedule a visit"). Both paths ship;
# this flag chooses between them per turn, so it is safe to flip back.
AGENT_TOOL_LOOP_ENABLED=false
AGENT_TOOL_LOOP_MAX_STEPS=6
AGENT_TOOL_LOOP_BUDGET_MS=25000
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AI_ADMIN_WHATSAPP_NUMBERS=
AI_EMPLOYEE_ROLLOUT_PERCENTAGE=100
AGENT_ACTION_CREDITS=15
DEV_TENANT_MAPPING=

# --- AWS credentials (local dev only; production uses Lambda IAM role) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Demo / safety flags ---
DEMO_TENANT_ID=DEMO_YOUR_TENANT
ALLOW_FAIL_OPEN=false
AI_EMPLOYEE_BYPASS_PROVISIONING=false
ALLOW_USER_CATEGORY_DEFAULT_FALLBACK=false
# RBAC category applied to a WhatsApp turn when the sender's principal
# (`wa:<phone>`) has no provisioned CATEGORY#USER row — which is every tenant
# today. `admin` reproduces the pre-existing behaviour exactly (the check used
# to be skipped altogether); set `whatsapp_bot` for a genuinely restricted bot
# on a shared number. Note whatsapp_bot forbids property and buyer writes, so
# it is NOT compatible with the WhatsApp-first flow as currently specified.
WHATSAPP_FALLBACK_CATEGORY=admin
# Tool-loop budget for an in-CRM web chat turn (Phase 5). Must leave headroom
# inside the Lambda's 30s timeout for classify and compose on top — a turn the
# platform kills returns nothing, which is worse than one that stops early.
AGENT_WEB_TOOL_LOOP_BUDGET_MS=18000

# --- AI DTO feature flags ---
USE_AI_DTO_FOR_LEADS=true
USE_AI_DTO_FOR_OWNERS=true
USE_AI_DTO_FOR_TENANTS=true
USE_AI_DTO_FOR_MEETINGS=true
USE_AI_DTO_FOR_BUYERS=true
USE_AI_DTO_FOR_PROPERTIES=true
USE_AI_DTO_FOR_CONTACTS=true

# --- MCP / OAuth ---
# MCP custom domain + base path (/oauth/* appended in code). Leave both empty
# if no MCP stack exists in this environment.
MCP_API_DOMAIN_NAME=your-api-custom-domain
MCP_API_BASE_PATH=your-mcp-base-path
OAUTH_CALLBACK_URL=
# Owned by the reality-flow-mcp stack, not this one — these must match the
# table names that stack actually created for the same environment. That
# stack predates this prefix change and uses realestate-flow-<env>-oauth-*,
# not realestateflow-<env>-*.
OAUTH_CONNECTIONS_TABLE=realestate-flow-dev-oauth-connections
OAUTH_CODES_TABLE_NAME=realestate-flow-dev-oauth-codes
OAUTH_SESSION_TTL_SEC=300
OAUTH_PENDING_TTL_SEC=900
DCR_LOOKUP_TTL_SEC=86400
FRONTEND_URL=https://app.yourdomain.com

# --- Operational constants ---
SERVICE_ACCOUNT_USER=system
DEFAULT_COUNTRY_CODE=+91
APP_URL=https://app.yourdomain.com
GRIEVANCE_OFFICER_EMAIL=info@yourdomain.com

# --- Optional integrations ---
AI_CALLING_INTERNAL_API_KEY=
# Shared secret lead-source adapters present as x-api-key to call
# POST /api/internal/adapters/leads. Used by backend_insta_sol_ms to promote
# Instagram enquiries into CRM leads. Deliberately separate from the AI-calling
# key so one service's compromise doesn't grant the other's access.
# Generate with: openssl rand -hex 32
ADAPTER_INTERNAL_API_KEY=
# Shared secret for POST/GET /api/internal/public-pages/* — the only door the
# public property-pages microservice has into CRM data. Its own key, separate
# from the adapter key above, so compromising the internet-facing pages service
# does not also hand over lead-ingestion access.
# Generate with: openssl rand -hex 32
PUBLIC_PAGES_INTERNAL_API_KEY=
# Custom domain + base path of ai-calling-service (Exotel + ElevenLabs), used by
# POST /leads/:id/qualify-call and /api/crm/ai-calling/*. The /api/ai-calling
# prefix is appended in code. Leave both empty until that stack is deployed.
AI_CALLING_SERVICE_DOMAIN_NAME=
AI_CALLING_SERVICE_BASE_PATH=
# Shared secret this backend presents as x-api-key on ai-calling-service's
# /api/ai-calling/* management routes. That service authenticates this backend
# as a service and then trusts the x-tenant-id we send, so this is a
# tenant-crossing credential — server-side only, never a browser bundle. Must
# equal CRM_CALLER_API_KEY in services/ai-calling-service/.env.<env>. Deliberately
# separate from AI_CALLING_INTERNAL_API_KEY, which is the inbound direction.
# Generate with: openssl rand -hex 32
CRM_CALLER_API_KEY=
# Custom domain + base path of followup-agent-service (the AI site-visit
# confirmation / post-visit feedback caller), used by
# POST /api/crm/leads/:id/followup-call, GET /api/crm/leads/:id/followups,
# POST /api/crm/followups/:jobId/cancel and the adapter/ManyChat follow-up
# hand-off. The /api/followup prefix is appended in code. Leave both empty
# until that stack is deployed: the proxy routes return 503 and hand-offs are
# logged and skipped, never failing the lead.
FOLLOWUP_SERVICE_DOMAIN_NAME=
FOLLOWUP_SERVICE_BASE_PATH=
# Shared secret this backend presents as x-api-key on followup-agent-service's
# /api/followup/* routes. Tenant-crossing credential (the service trusts our
# x-tenant-id) - server-side only. Must equal FOLLOWUP_CALLER_API_KEY in
# services/followup-agent-service/.env.<env>. Generate with: openssl rand -hex 32
FOLLOWUP_CALLER_API_KEY=
# Shared secret followup-agent-service presents as x-api-key to call
# /api/internal/followups/* (lead snapshot, escalations, notes). Its own key,
# separate from AI_CALLING_INTERNAL_API_KEY and ADAPTER_INTERNAL_API_KEY, so
# compromising the follow-up stack grants neither of the others' access. Must
# equal CRM_INTERNAL_API_KEY in services/followup-agent-service/.env.<env>.
# Generate with: openssl rand -hex 32
FOLLOWUP_INTERNAL_API_KEY=
AISENSY_API_KEY=

# --- Call intelligence (call recording -> transcript -> AI analysis) ---
# Leave CALL_RECORDING_QUEUE_URL empty locally: the pipeline then runs inline
# instead of through SQS. In AWS it is set by CloudFormation.
CALL_RECORDING_QUEUE_URL=
ASR_PROVIDER=amazon-transcribe
# Comma separated list used for Amazon Transcribe automatic language identification.
TRANSCRIBE_LANGUAGE_OPTIONS=en-IN,hi-IN,mr-IN,gu-IN,ta-IN,te-IN,kn-IN,ml-IN,pa-IN,bn-IN
# Set a single language code to disable automatic identification (required for custom vocabulary).
TRANSCRIBE_LANGUAGE_CODE=
TRANSCRIBE_VOCABULARY_NAME=
# Apply only the AI call-summary note automatically; every other action needs owner approval.
CALL_INTEL_AUTO_APPLY_NOTES=true
CALL_INTEL_POLL_DELAY_SECONDS=45
CALL_INTEL_MAX_POLL_ATTEMPTS=60
CALL_INTEL_MAX_STAGE_ATTEMPTS=4
CALL_INTEL_MAX_TRANSCRIPT_CHARS=60000
CALL_INTEL_DEFAULT_MEETING_TIME=11:00
CALL_INTEL_UPLOAD_URL_TTL_SECONDS=900
CALL_INTEL_PLAYBACK_URL_TTL_SECONDS=3600
# Bytes, default 200 MB. Enforced against the actual uploaded object, not just the client's claim.
CALL_INTEL_MAX_UPLOAD_BYTES=209715200
# How long a recording may sit in ANALYZING before a read re-drives the stage.
# ANALYZING is deliberately un-claimable (that is what stops duplicate Gemini
# runs), so a worker that dies mid-analysis needs this to recover. Must be
# comfortably longer than a real analysis, or a live worker gets pre-empted.
CALL_INTEL_STALLED_ANALYSIS_MS=900000
