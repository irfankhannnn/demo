{
  "name": "real-estate-crm-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:prod": "vite build --mode prod",
    "build:mobile": "vite build --mode mobile",
    "preview": "vite preview",
    "lint": "eslint .",
    "setup": "node scripts/create-env.js",
    "android": "cap open android",
    "ios": "cap open ios",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "mobile:build": "npm run build:mobile && npx cap sync",
    "mobile:android": "npm run mobile:build && npx cap run android",
    "mobile:ios": "npm run mobile:build && npx cap run ios",
    "mobile:assets": "npx @capacitor/assets generate",
    "test:e2e": "playwright test --config=../../../tests/playwright/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=../../../tests/playwright/playwright.config.ts --ui",
    "test:e2e:mobile": "playwright test --config=../../../tests/playwright/playwright.config.ts --project=mobile-android --project=mobile-ios",
    "test:e2e:headed": "playwright test --config=../../../tests/playwright/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=../../../tests/playwright/playwright.config.ts --debug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@react-google-maps/api": "^2.20.8",
    "@sentry/react": "^10.56.0",
    "lucide-react": "^0.344.0",
    "posthog-js": "^1.380.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.42.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
