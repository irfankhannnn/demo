# =============================================================================
# RealtyFlow Instagram Console — Environment Template
# Copy to .env for local development. Never commit a real .env.
# =============================================================================

# Instagram microservice API = https://<DOMAIN_NAME>/<BASE_PATH>. The client
# appends `/api/insta` itself. DOMAIN_NAME is the API Gateway custom domain
# (bare hostname); raw API Gateway invoke hosts are rejected. A full origin is
# accepted for local development only, with BASE_PATH left empty.
#   local : http://localhost:3101                + (empty)
#   dev   : services-api.cloudberrysolutions.in  + devrealestateinsta
#   prod  : services-api.realestateflow.in       + prodrealestateinsta
VITE_INSTA_API_DOMAIN_NAME=http://localhost:3101
VITE_INSTA_API_BASE_PATH=

# Origin of the CRM app. Used for the "Back to CRM" link and for the redirect
# to /login when the API answers 401. No trailing slash.
VITE_CRM_URL=http://localhost:3000

# Dev server port (optional, defaults to 3100).
VITE_PORT=3100
