# =============================================================================
# RealEstateFlow Landing Pages — prod environment
# Copy to .env.prod and fill in real values.
#
# This file is read by TWO things:
#   1. `LP_ENV=prod node build/scripts/process-partials.js` (the ALL_CAPS
#      keys below) — injected as {{TOKEN}} into the built HTML at build time.
#      These are NOT runtime env vars; they become static strings in dist/.
#   2. `infra/deploy.sh prod` (AWS_REGION / SERVICE_NAME / FRONTEND_* keys)
#      for the S3 + CloudFront stack it deploys/updates.
#
# Every physical AWS resource cfn-landing-pages.yaml creates is named
# prod-realestateflow-landing-pages-<resource> (env first) — keep
# SERVICE_NAME set to realestateflow-landing-pages.
# =============================================================================

# --- Deploy (infra/deploy.sh prod) ---
AWS_REGION=ap-south-1
# ENV is NOT read from this file by deploy.sh — it's forced from the
# dev|prod argument you pass on the command line, so it can't drift.
SERVICE_NAME=realestateflow-landing-pages
# Optional — leave blank to default to ${ENV}-${SERVICE_NAME}
# (prod-realestateflow-landing-pages). Must be globally unique across all of S3.
FRONTEND_S3_BUCKET_NAME=
FRONTEND_PRICE_CLASS=PriceClass_200
# Apex domain only, e.g. realestateflow.in — leave blank to use the
# *.cloudfront.net URL until DNS/cert are ready.
FRONTEND_CUSTOM_DOMAIN_NAME=realestateflow.in
# 'true' also adds www.<domain> as a second alias on this distribution,
# 301-redirected to the apex by the CloudFront Function (one canonical URL).
FRONTEND_INCLUDE_WWW_ALIAS=true
# Required if FRONTEND_CUSTOM_DOMAIN_NAME is set. Must be an ACM cert in
# us-east-1 covering both the apex and (if enabled) the www SAN.
FRONTEND_ACM_CERTIFICATE_ARN=
# Optional — only needed if the domain's DNS is managed in this AWS account's
# Route53 and you want deploy.sh to create the alias record(s) automatically.
# Leave blank and point your DNS provider at DistributionDomainName manually
# otherwise (this is the expected path for realestateflow.in today — no
# Route53 hosted zone exists for it in this account yet).
FRONTEND_HOSTED_ZONE_ID=
# Optional — AWS WAF WebACL ARN (scope CLOUDFRONT, us-east-1)
FRONTEND_WAF_WEB_ACL_ARN=

# --- Build/release tracking (infra/cicd/agency-app/landing-pages/deploy.sh) ---
# Created by infra/cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment for build archives (dist.tar.gz
# + CFN template snapshots), the same bucket the other services use.
ARTIFACT_BUCKET=prod-realestateflow-artifacts

# =============================================================================
# Build-time content tokens ({{TOKEN}} in the HTML) — same shape as
# agency-app/landing-pages/.env.example, just environment-scoped.
# =============================================================================

# --- Analytics IDs ---
GA4_ID=G-XXXXXXXXXX
META_PIXEL_ID=XXXXXXXXXXXXXXXXXX
LINKEDIN_PARTNER_ID=XXXXXXX
HOTJAR_ID=XXXXXXX
# Hotjar snippet/script version — required alongside HOTJAR_ID by
# head-analytics.hbs's hj() init call (not in agency-app/landing-pages/.env.example
# today; 6 is Hotjar's current tracking-code version).
HOTJAR_SV=6
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
POSTHOG_HOST=https://eu.i.posthog.com

# --- Contact / CTA placeholders ---
CAL_HANDLE=realestateflow/demo
WHATSAPP_NUMBER=919876543210
CONTACT_EMAIL=info@realestateflow.in

# --- Site URLs ---
APP_URL=https://app.realestateflow.in
SITE_URL=https://realestateflow.in
