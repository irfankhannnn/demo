# =============================================================================
# RealEstateFlow CRM — mobile (Capacitor) build environment
# Copy to .env.mobile and fill in real values.
#
# Read by `vite build --mode mobile` (npm run build:mobile), whose output is
# bundled into the Android APK/AAB and the iOS IPA by `npx cap sync`.
#
# Unlike the web builds there is no deploy step and no FRONTEND_* keys — the
# artifact is a binary that goes to the stores, not to S3.
#
# !!! EVERY VITE_* VALUE HERE IS EXTRACTABLE FROM THE SHIPPED APP. !!!
# An APK is a zip and an IPA is a zip. Assume anything below is public.
# Never put a secret key, an admin token, or a server-side credential here.
#
# !!! THESE VALUES ARE FROZEN AT BUILD TIME. !!!
# You cannot change one without shipping a new binary through store review.
# Anything you may need to turn off in a hurry must be server-driven instead.
# =============================================================================

# --- App ---
VITE_APP_TITLE=RealEstateFlow

# --- Mobile build marker ---
# Read only through src/lib/platform.ts. Drives the native UI branches:
# billing stripped for App Store guideline 3.1.1, bottom tab bar, no cookie banner.
VITE_IS_NATIVE_BUILD=true

# --- CRM API (same production backend as the web app) ---
# Server CRM REST API. Bare custom-domain host + single-segment base path;
# the app appends /api itself (src/config/apiConfig.ts). Raw execute-api hosts are rejected.
VITE_CRM_API_DOMAIN_NAME=services-api.cloudberrysolutions.in
VITE_CRM_API_BASE_PATH=realestatecrm
# NOTE: realestatecrm is a pre-existing value with no mapping on either domain
# today (dev uses devrealestatecrm, prod prodrealestatecrm on services-api.realestateflow.in).
# Left unchanged pending a decision on which backend the store build targets.

# --- Tenant (fallback only; production resolves from the user profile) ---
# Leave blank for mobile. A real tenant id shipped in a binary would be sent
# as the tenant header for any user whose profile fails to load.
VITE_TENANT_ID=

# --- Google Maps ---
# Use a SEPARATE key from the web build. HTTP-referrer restrictions cannot
# protect a key in a WebView (the referrer is https://localhost), and the Maps
# JavaScript API cannot be restricted by bundle id or package name — only the
# native SDKs can. Restrict this key to the Maps JavaScript API alone and set
# a hard daily quota cap plus billing alerts.
VITE_GOOGLE_MAPS_API_KEY=your_mobile_restricted_maps_key_here

# --- Authentication ---
VITE_AUTH_API_DOMAIN_NAME=your-auth-api-custom-domain
VITE_AUTH_API_BASE_PATH=your-auth-api-base-path
# reality-flow-mcp — optional. Blank = no MCP server in this env (the Claude
# Desktop setup snippet shows "not available"). The app appends /mcp itself.
VITE_MCP_API_DOMAIN_NAME=
VITE_MCP_API_BASE_PATH=
VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_cognito_client_id_here
# Custom scheme, NOT an https URL. OAuth runs in a real browser (Chrome Custom
# Tabs / SFSafariViewController) and returns here via a deep link, because
# Google rejects OAuth inside embedded WebViews with disallowed_useragent.
# Both URIs must also be registered as callback/logout URLs on the Cognito client.
VITE_AUTH_REDIRECT_URI=in.realestateflow.app://auth/callback
VITE_AUTH_LOGOUT_URI=in.realestateflow.app://auth/logout

# --- Analytics (PostHog) ---
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Billing ---
# Deliberately blank. All purchasing is stripped from mobile builds to comply
# with App Store guideline 3.1.1 and Google Play Billing; plans are bought on
# the web. If this is ever set, confirm nothing renders a purchase path first.
VITE_RAZORPAY_KEY_ID=

# --- Public forms ---
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
VITE_GRIEVANCE_OFFICER_NAME=Grievance Officer

# --- Feature flags ---
# Keep AI calling off for store submission. The calling service records calls
# by default with no callee consent capture and no privacy-policy disclosure.
VITE_AI_CALLING_ENABLED=false
VITE_BAILEY_ENABLED=true
VITE_IS_DEMO=false

# --- Error monitoring (optional) ---
VITE_SENTRY_DSN=

# Support WhatsApp number, digits + country code (e.g. 919876543210).
# Support links are hidden when unset rather than rendering a dead link.
VITE_SUPPORT_WHATSAPP=

# Base URL of the hosted legal documents (privacy, terms, cookies, refund).
VITE_LEGAL_BASE_URL=https://realestateflow.in/legal
