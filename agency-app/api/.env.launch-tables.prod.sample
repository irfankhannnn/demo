# =============================================================================
# RealEstateFlow Launch Tables — prod environment
# Copy to .env.launch-tables.prod and fill in real values.
#
# Consumed by infra/deploy-launch-tables.sh prod, which deploys
# infra/launch-tables-cfn.yaml as its own stack (prod-realestateflow-launch-tables).
# This is separate from .env.prod (which is for cfn-backend.yaml) because the
# two templates own completely different resources and deploy independently.
# =============================================================================

AWS_REGION=ap-south-1

# Created by infra/cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment. Used here only to archive a
# copy of launch-tables-cfn.yaml for build tracking (this stack has no
# Lambda code, so there's nothing else to upload).
ARTIFACT_BUCKET=prod-realestateflow-artifacts
