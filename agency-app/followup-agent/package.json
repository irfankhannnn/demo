{
  "name": "followup-agent-service",
  "version": "1.0.0",
  "description": "Follow-up calling agent for the RealtyFlow CRM - schedules, retries and escalates ElevenLabs/Exotel follow-up calls",
  "type": "module",
  "main": "src/lambda-api.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "deploy:dev": "bash ../../infra/cicd/agency-app/followup-agent/deploy.sh dev",
    "deploy:prod": "bash ../../infra/cicd/agency-app/followup-agent/deploy.sh prod",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
