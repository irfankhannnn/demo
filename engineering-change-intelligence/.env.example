# Engineering Change Intelligence — Environment Variables

# Slack Integration (required for posting reports)
SLACK_PR_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Optional Slack customization
SLACK_BOT_NAME=PR Intelligence Bot
SLACK_PR_CHANNEL=#engineering-reviews

# GitHub (for PR fetching via gh CLI)
# GITHUB_TOKEN is auto-provided in GitHub Actions
# For local/Cursor Cloud, use: gh auth login

# Analysis configuration
ECI_BASE_BRANCH=main
ECI_OUTPUT_DIR=engineering-change-intelligence/reports/current

# GitHub repository (auto-detected from git remote)
# GITHUB_REPOSITORY=org/repo
