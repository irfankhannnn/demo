{
  "name": "whatsapp-platform",
  "version": "1.0.0",
  "description": "Self-hosted multi-tenant WhatsApp platform on Baileys — ECS-ready with local fallback",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.669.0",
    "@aws-sdk/client-dynamodb": "^3.669.0",
    "@aws-sdk/client-eventbridge": "^3.669.0",
    "@aws-sdk/client-s3": "^3.669.0",
    "@aws-sdk/lib-dynamodb": "^3.669.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
