# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# ─── Storage mode ─────────────────────────────────────────────────────────────
# LOCAL_STORAGE=true  → filesystem (default for local dev, auto-detected)
# LOCAL_STORAGE=false → S3 + DynamoDB (auto-detected when SESSION_BUCKET_NAME is set)
LOCAL_STORAGE=true

# ─── Auth / API keys ──────────────────────────────────────────────────────────
# All three mandatory in production.
BAILEYS_API_KEY=change-me-to-a-long-random-string
BAILEYS_ADMIN_API_KEY=change-me-to-a-different-long-random-string
BAILEYS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── CRM integration ──────────────────────────────────────────────────────────
# Webhook target when USE_EVENTBRIDGE=false (local/direct mode)
CRM_WEBHOOK_URL=http://localhost:4000/api/webhooks/whatsapp
# Optional separate CRM webhook secret (falls back to BAILEYS_WEBHOOK_SECRET)
CRM_WEBHOOK_SECRET=

# ─── Local filesystem storage (LOCAL_STORAGE=true) ────────────────────────────
AUTH_STATE_DIR=./auth_state
AUTH_BACKUP_DIR=./auth-backups
AUTH_ENCRYPTION_KEY=change-me-to-32-plus-char-random-string

# ─── Session defaults ─────────────────────────────────────────────────────────
DEFAULT_SESSION_PHONE=
BROWSER_NAME=Chrome

# ─── AWS (required when LOCAL_STORAGE=false / ECS deployment) ─────────────────
AWS_REGION=ap-south-1
SESSION_BUCKET_NAME=
SESSION_KMS_KEY_ID=
SESSION_TABLE_NAME=dev-whatsapp-sessions

# ─── EventBridge (ECS mode) ───────────────────────────────────────────────────
# USE_EVENTBRIDGE=true  → async events via EventBridge (ECS)
# USE_EVENTBRIDGE=false → direct webhook to CRM (local/default)
USE_EVENTBRIDGE=false
EVENT_BUS_NAME=default

# ─── CloudWatch metrics (ECS mode) ────────────────────────────────────────────
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=WhatsAppPlatform

# ─── ECS task metadata (auto-injected in ECS; override for local dev) ──────────
ECS_TASK_ID=local
ECS_TASK_ARN=
MAX_SESSIONS_PER_TASK=100
RESTORE_ON_STARTUP=true

# ─── Baileys tuning ───────────────────────────────────────────────────────────
QR_TIMEOUT_MS=60000
SEND_MESSAGE_TIMEOUT_MS=30000
MESSAGE_DEBOUNCE_MS=0
HEALTH_PROBE_INTERVAL_MS=30000
HEALTH_PROBE_TIMEOUT_MS=10000
DEFAULT_QUERY_TIMEOUT_MS=60000
PREKEY_ROTATION_INTERVAL_MS=21600000
SOFT_RESET_MAX_RETRIES=2

# ─── AI self-chat triggers ────────────────────────────────────────────────────
AI_SELF_CHAT_TRIGGERS=AI:,Bot:,Hey bot
