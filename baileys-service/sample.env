# Baileys self-hosted WhatsApp service
PORT=3003
NODE_ENV=production
LOG_LEVEL=info

# AWS region used for any AWS SDK calls (optional)
AWS_REGION=ap-south-1

# Directory where Baileys auth state is persisted
# Use a Docker volume or EFS mount in production
AUTH_STATE_DIR=./auth_state

# Default WhatsApp number to send FROM when CRM messages do not include a `from` field
# Example: 919876543210 (with country code, no + or spaces)
DEFAULT_SESSION_PHONE=

# Secret shared with CRM for signing/verifying incoming webhooks
# Mandatory in production. Must match the CRM's BAILEY_WEBHOOK_SECRET.
BAILEYS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# API key for CRM-to-service authentication
# Mandatory in production. Must match the CRM's BAILEY_API_KEY.
BAILEYS_API_KEY=change-me-to-a-long-random-string

# Admin API key for destructive operations (forceNew re-linking, deleteAuthState)
# Mandatory in production. Must match the CRM's BAILEY_ADMIN_API_KEY.
# This is a separate key from BAILEYS_API_KEY to provide defense-in-depth:
# if the regular API key leaks, destructive operations still require this key.
BAILEYS_ADMIN_API_KEY=change-me-to-a-different-long-random-string

# CRM webhook endpoint to forward incoming WhatsApp messages
# Mandatory in production. This is the CRM's /api/webhooks/whatsapp route.
# For local dev, use http://localhost:4000/api/webhooks/whatsapp
CRM_WEBHOOK_URL=https://api.realestateflow.in/api/webhooks/whatsapp

# Optional: separate CRM webhook secret (falls back to BAILEYS_WEBHOOK_SECRET)
CRM_WEBHOOK_SECRET=

# Timeouts
QR_TIMEOUT_MS=60000
SEND_MESSAGE_TIMEOUT_MS=30000

# Browser name passed to WhatsApp Web (use a real browser name to avoid blocks)
BROWSER_NAME=Chrome

# Encryption key for credential backups (auth-store.js)
# Mandatory in production. Use a long random string (32+ characters).
# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# Directory for encrypted credential backups
# Defaults to ./auth-backups
AUTH_BACKUP_DIR=./auth-backups

# AI self-chat trigger words (comma-separated)
# Messages starting with these prefixes are processed even if fromMe
AI_SELF_CHAT_TRIGGERS=AI:,Bot:,Hey bot
