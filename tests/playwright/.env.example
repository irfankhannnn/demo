# Copy this file to .env and fill in values.

# Frontend dev server URL
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Hosted backend API endpoint (production-like)
# For local Phase 0-6 ownership/listing verification, override:
#   PLAYWRIGHT_API_URL=http://localhost:4000/api
PLAYWRIGHT_API_URL=https://services-api.cloudberrysolutions.in/devrealestatecrm/api

# Test credentials for phone OTP authentication
TEST_PHONE=
TEST_OTP=

# Optional: tokens for security tests (cross-tenant pentest, seat-cap)
# TENANT_A_TOKEN=
# TENANT_B_TOKEN=
# SOLO_TENANT_TOKEN=
# TEAM_TENANT_TOKEN=
