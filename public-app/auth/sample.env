# ============================================================
# marketplace-authentication — Environment Config (sample)
# ============================================================
# Copy to .env.dev / .env.prod for infra/deploy.sh (./infra/deploy.sh dev)
# or to .env / .env.local for `npm run dev`. Every value below is a
# placeholder — nothing here is a real key.
#
# Every physical AWS resource cfn-backend.yaml creates is named
# <dev|prod>-realestateflow-marketplace-auth-<resource> (env first); the
# stack is <env>-realestateflow-marketplace-auth-stack. Keep SERVICE_NAME as
# realestateflow-marketplace-auth.

# --- AWS Region ---
AWS_REGION=ap-south-1

# --- Stack / Service ---
# ENV is NOT read from this file by deploy.sh — it is forced from the
# dev|prod CLI argument so it can never drift.
SERVICE_NAME=realestateflow-marketplace-auth
LOG_LEVEL=info

# --- Cognito (filled from stack outputs UserPoolId / UserPoolClientId after
#     the first deploy; only needed for `npm run dev` — the Lambda gets them
#     from CloudFormation) ---
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Managed-login domain is <env>-realestateflow-marketplace-auth (see the
# HostedUiDomain stack output).
COGNITO_HOSTED_UI_DOMAIN=https://dev-realestateflow-marketplace-auth.auth.ap-south-1.amazoncognito.com

# --- Google OAuth (consumer marketplace client, from Google Cloud Console) ---
# Authorised redirect URI on the Google side is the Cognito domain's
# /oauth2/idpresponse, NOT marketplace-web's callback.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- DynamoDB tables (created by this stack; `npm run dev` only) ---
USERS_TABLE=dev-realestateflow-marketplace-auth-users
IDENTITIES_TABLE=dev-realestateflow-marketplace-auth-identities

# --- Lambda deployment ---
# One shared artifact bucket per environment (infra/cicd/common-infra);
# deploy.sh insists this equals <env>-realestateflow-artifacts.
LAMBDA_PACKAGES_BUCKET_NAME=dev-realestateflow-artifacts
LAMBDA_MEMORY_SIZE=256
LAMBDA_TIMEOUT=30
LOG_RETENTION_DAYS=14

# --- Networking (optional; blank = API Lambda runs outside a VPC) ---
SUBNET_IDS=
SECURITY_GROUP_IDS=

# --- Custom domain / API Gateway base path mapping ---
# Like every backend, this API is mapped onto the environment's shared API
# Gateway custom domain:
#   dev:  services-api.cloudberrysolutions.in + devrealestatemarketplaceauth
#   prod: services-api.realestateflow.in      + prodrealestatemarketplaceauth
# deploy.sh rejects a scheme (https://) or a raw *.execute-api.* host here,
# and refuses an empty domain/base path once mapping is enabled. Keep
# ENABLE_BASE_PATH_STRIP in lockstep with ENABLE_CUSTOM_DOMAIN_MAPPING. Only
# the WEB domain of the marketplace is still undecided; it does not appear here.
MARKETPLACE_AUTH_DOMAIN_NAME=services-api.cloudberrysolutions.in
MARKETPLACE_AUTH_BASE_PATH=devrealestatemarketplaceauth
ENABLE_CUSTOM_DOMAIN_MAPPING=true
ENABLE_BASE_PATH_STRIP=true

# --- marketplace-api (outbound: DELETE /internal/users/:id on account deletion) ---
# Blank means the purge call is skipped (logged as a warning, never fatal).
MARKETPLACE_API_DOMAIN_NAME=services-api.cloudberrysolutions.in
MARKETPLACE_API_BASE_PATH=devrealestatemarketplace
# Must equal marketplace-api's AUTH_CALLER_API_KEY. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_CALLER_API_KEY=replace-with-a-64-hex-secret

# --- Inbound service-to-service key for GET /internal/users/:userId ---
INTERNAL_API_KEY=replace-with-a-64-hex-secret

# --- Managed-login redirect URLs (comma-separated; marketplace-web) ---
IDENTITY_CALLBACK_URL=http://localhost:5173/auth/callback
IDENTITY_LOGOUT_URL=http://localhost:5173/

# --- CORS (comma-separated origins of marketplace-web) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Dev/testing OTP override ---
# TEST_OTP_ENABLED=true makes the CreateAuthChallenge trigger use
# TEST_OTP_CODE and skip SNS. deploy.sh refuses this in .env.prod.
TEST_OTP_ENABLED=false
TEST_OTP_CODE=123456

# --- Local dev only ---
PORT=3007
# Per-IP limits are low (3 OTP starts / 15 min); disable on a dev machine.
RATE_LIMIT_DISABLED=false
