# =============================================================================
# RealEstateFlow Homes (marketplace-web) — dev environment
# Copy to .env.dev and fill in real values.
#
# Read by TWO things:
#   1. `vite build --mode dev` (VITE_* keys) — see infra/deploy.sh
#   2. `infra/deploy.sh dev` (AWS_REGION / SERVICE_NAME / WEB_* keys)
#      for the S3 + CloudFront stack it deploys/updates.
#
# Every physical AWS resource cfn-marketplace-web.yaml creates is named
# dev-realestateflow-marketplace-web-<resource> — keep SERVICE_NAME set to
# realestateflow-marketplace-web.
# =============================================================================

# --- Deploy (infra/deploy.sh dev) ---
AWS_REGION=ap-south-1
# Optional named AWS CLI profile. Blank = default credential chain.
AWS_PROFILE=
# ENV is NOT read from this file — it is forced from the dev|prod CLI argument.
SERVICE_NAME=realestateflow-marketplace-web
# Optional — leave blank to default to ${ENV}-${SERVICE_NAME}
WEB_S3_BUCKET_NAME=
WEB_PRICE_CLASS=PriceClass_200
# PLACEHOLDER — the public domain is TBD. Leave all three blank to serve from
# the *.cloudfront.net URL. When set, all three are required together.
WEB_DOMAIN_NAME=
# ACM cert for WEB_DOMAIN_NAME — MUST be issued in us-east-1 (CloudFront rule).
WEB_ACM_CERTIFICATE_ARN=
WEB_HOSTED_ZONE_ID=
# Optional — AWS WAF WebACL ARN (scope CLOUDFRONT, us-east-1)
WEB_WAF_WEB_ACL_ARN=

# --- Build/release tracking (infra/cicd/public-app/web/deploy.sh) ---
# One shared artifact bucket per environment (infra/cicd/common-infra).
ARTIFACT_BUCKET=dev-realestateflow-artifacts

# --- App (baked into the bundle at build time) ---
VITE_SITE_NAME="RealEstateFlow Homes (Dev)"
# marketplace-api base URL — full origin + base path, no trailing slash.
# PLACEHOLDER domain: dev may use the raw execute-api URL until the custom
# domain is mapped (see docs/public-app/api/API-CONTRACT.md §2).
VITE_MARKETPLACE_API_URL=https://services-api.cloudberrysolutions.in/devrealestatemarketplace
# marketplace-authentication base URL. PLACEHOLDER domain.
VITE_MARKETPLACE_AUTH_URL=https://services-api.cloudberrysolutions.in/devrealestatemarketplaceauth
VITE_GOOGLE_MAPS_EMBED_KEY=
VITE_HCAPTCHA_SITE_KEY=
