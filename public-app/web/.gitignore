# Logs
logs
*.log
npm-debug.log*
npm-install.log

node_modules
dist
dist-ssr
*.local
*.timestamp-*.mjs

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Environment files — glob so a new .env.<env> is caught automatically
# (a plain ".env" line does NOT match ".env.dev"/".env.prod")
.env
.env.*
!.env.sample
!.env.*.sample

# Build artefacts regenerated by infra/deploy.sh on every run — never hand-edit
infra/cfn-params.json
infra/.last-config-diff.json
infra/.last-config-params.json

# Test output
coverage
