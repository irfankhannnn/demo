# marketplace-api — consumer-facing API of the AI property-matching marketplace
#
# Copy to .env.dev / .env.prod and fill in. Deploy scripts read .env.<env>;
# nothing here is committed with a real value.
#
# Values marked REQUIRED are checked at cold start by config/env.js — the
# Lambda fails its first invocation with a readable message if any is missing,
# rather than answering 500s to real buyers.

NODE_ENV=production
AWS_REGION=ap-south-1
PORT=3006
LOG_LEVEL=info

# ── CRM internal API (REQUIRED) ───────────────────────────────────────────
# The ONLY route this service has to listing data: the CRM API's custom
# domain (host only, no scheme) + its base path. The /api/internal/marketplace
# prefix is appended in code. Raw execute-api hosts are rejected.
#   dev:  services-api.cloudberrysolutions.in + devrealestatecrm
#   prod: services-api.realestateflow.in      + prodrealestatecrm
#   local: http://localhost:3001 with an empty base path (a scheme is allowed
#          only for local development)
CRM_INTERNAL_API_DOMAIN_NAME=
CRM_INTERNAL_API_BASE_PATH=
# Presented to the CRM as x-api-key. Must equal agency-app/api/.env.<env>'s
# MARKETPLACE_INTERNAL_API_KEY exactly. Generate with: openssl rand -hex 32
MARKETPLACE_INTERNAL_API_KEY=
# A cold marketplace Lambda calling a cold CRM Lambda needs headroom; keep
# comfortably under LAMBDA_TIMEOUT.
CRM_TIMEOUT_MS=12000

# ── Inbound service callers (REQUIRED, must differ) ───────────────────────
# Keys accepted on /internal/*. The CRM presents CRM_CALLER_API_KEY (its
# MARKETPLACE_CALLER_API_KEY); marketplace-authentication presents
# AUTH_CALLER_API_KEY on account deletion. Generate each with:
# openssl rand -hex 32
CRM_CALLER_API_KEY=
AUTH_CALLER_API_KEY=

# ── Consumer identity (REQUIRED) ──────────────────────────────────────────
# The marketplace consumer user pool, created by the marketplace-authentication
# stack. Bearer tokens are verified against its JWKS.
COGNITO_USER_POOL_ID=
COGNITO_REGION=ap-south-1
# Optional. When set, tokens must carry this client_id (access) / aud (id).
COGNITO_CLIENT_ID=

# ── LLM ───────────────────────────────────────────────────────────────────
# gemini | bedrock. Both adapters implement the same two calls (parse intent,
# explain results). Without a working model, AI search falls back to a
# deterministic Hinglish-aware parser and returns results with why: null.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Used only when MODEL_PROVIDER=bedrock; the stack grants invoke on exactly
# this id. Foundation model id or an inference profile id.
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_TIMEOUT_MS=8000

# ── Browser origin (PLACEHOLDER) ──────────────────────────────────────────
# Where marketplace-web is served from, comma-separated if more than one.
# Drives CORS and the share-page redirect. The marketplace domain is not
# chosen yet: leave empty and CORS reflects any origin in development, and is
# CLOSED in production (share pages then redirect to this API's own /share).
#   e.g. https://homes.realestateflow.in
MARKETPLACE_WEB_ORIGIN=

# ── Email (optional) ──────────────────────────────────────────────────────
# Verified SES sender for "an agency replied" emails to buyers who have an
# email on their profile. Empty disables email (and the ses:SendEmail grant).
SES_FROM_EMAIL=

# ── Storage (REQUIRED) ────────────────────────────────────────────────────
# The single table this service owns (profiles, saved, searches, threads,
# messages, rate-limit counters). Created by infra/cfn-marketplace-api.yaml.
#   dev:  dev-realestateflow-marketplace
#   prod: prod-realestateflow-marketplace
MARKETPLACE_TABLE_NAME=

# ── Abuse controls ────────────────────────────────────────────────────────
# Optional salt for hashing phone numbers into rate-limit keys.
# Generate with: openssl rand -hex 32
MARKETPLACE_SESSION_SECRET=

# Public reads per IP.
LIMIT_IP_BURST=20
LIMIT_IP_BURST_WINDOW_SECONDS=10
LIMIT_IP_HOURLY=600
# Site-visit bookings — each is a lead + a calendar slot in an agency's CRM.
LIMIT_IP_BOOKINGS_DAILY=6
LIMIT_PHONE_BOOKINGS_DAILY=3
# The backstop on AI-qualification spend: every booking creates a lead, and a
# lead can trigger a billable AI call. Bounds a tenant's worst-case daily
# exposure to an attack.
LIMIT_TENANT_BOOKINGS_DAILY=200
LIMIT_CAPTCHA_TRIGGER=3
# AI search costs a model call per request. Anonymous callers by IP,
# logged-in buyers by user id.
LIMIT_AI_SEARCH_ANON_HOURLY=20
LIMIT_AI_SEARCH_USER_HOURLY=60
# Messages, pings, saves and searches per buyer per hour.
LIMIT_BUYER_WRITES_HOURLY=120

# Forces the in-memory counter store. Local development only — counters
# become per-process and are useless as a real limit. Never set this in a
# deployed environment.
# GUARD_STORE=memory

# ── Captcha (optional, reserved; set BOTH or NEITHER) ─────────────────────
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ── Caching ───────────────────────────────────────────────────────────────
# In-process TTL for CRM reads: an agency editing a listing sees the
# marketplace catch up within this many seconds.
LISTING_CACHE_SECONDS=60
CITIES_CACHE_SECONDS=300
# Edge cache for image/document redirects. MUST stay well under the 900 s
# presigned URL lifetime, or a cached redirect outlives its signature.
ASSET_CACHE_SECONDS=300
# s-maxage on public JSON reads (cities, listings, detail, similar, share).
PUBLIC_CACHE_SECONDS=60

# ── This API's own custom domain + base path (PLACEHOLDER) ────────────────
# The marketplace API domain is not decided. Until it is, leave the domain
# empty with the mapping OFF and use the raw execute-api URL the stack prints
# (MarketplaceExecuteApiUrl output). Once the domain exists:
#   MARKETPLACE_API_DOMAIN_NAME=services-api.cloudberrysolutions.in  (dev)
#   MARKETPLACE_API_BASE_PATH=devrealestatemarketplace
#   ENABLE_CUSTOM_DOMAIN_MAPPING=true
#   ENABLE_BASE_PATH_STRIP=true
# Raw execute-api hosts are refused in this variable; empty is allowed while
# the mapping is off.
MARKETPLACE_API_DOMAIN_NAME=
MARKETPLACE_API_BASE_PATH=
ENABLE_CUSTOM_DOMAIN_MAPPING=false
ENABLE_BASE_PATH_STRIP=false
# CloudFront requires the custom domain mapping (its origin is that domain).
ENABLE_CLOUDFRONT=false
API_STAGE_NAME=v1

# ── Lambda sizing (deploy-time) ───────────────────────────────────────────
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_MEMORY_SIZE=512
# Must exceed CRM_TIMEOUT_MS + MODEL_TIMEOUT_MS with headroom.
LAMBDA_TIMEOUT=25
LOG_RETENTION_DAYS=30

# ── Deploy-time only (read by infra/deploy.sh, not by the app) ────────────
SERVICE_NAME=realestateflow-marketplace-api
# REQUIRED by infra/deploy.sh. Must start with "<env>-realestateflow-" — the
# script refuses to run otherwise, so a copy-pasted env file cannot create a
# stack that matches nothing else in the account.
#   dev:  dev-realestateflow-marketplace-api-stack
#   prod: prod-realestateflow-marketplace-api-stack
STACK_NAME=
#   dev:  dev-realestateflow-artifacts
#   prod: prod-realestateflow-artifacts
ARTIFACT_BUCKET=
# Key prefix inside the artifact bucket. REQUIRED.
#   dev:  dev-realestateflow/marketplace-api
ARTIFACT_PREFIX=
# REQUIRED. dev -> cloudberry-main, prod -> cloudberry-prod-new.
AWS_PROFILE=
