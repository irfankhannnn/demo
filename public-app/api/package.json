{
  "name": "marketplace-api",
  "version": "1.0.0",
  "description": "Consumer-facing API of the AI property-matching marketplace — Express on Lambda; holds consumer data only and reads every listing from the CRM's internal API at request time",
  "type": "module",
  "main": "lambda.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sesv2": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "serverless-http": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
