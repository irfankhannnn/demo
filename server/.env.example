# Backend server
PORT=3001
AWS_REGION=ap-south-1

# DynamoDB tables (see CloudFormation outputs)
DYNAMODB_TABLE_NAME=real-estate-core
CRM_DYNAMODB_TABLE_NAME=real-estate-crm
AGENCY_CONFIG_DYNAMODB_TABLE_NAME=real-estate-agencies
ENQUIRIES_DYNAMODB_TABLE_NAME=real-estate-enquiries
AREAS_DYNAMODB_TABLE_NAME=real-estate-areas
B2B_LEADS_TABLE=cloudberry-real-estate-b2b-details

# Real Estate Management Tables (Developers, Areas, Projects)
DEVELOPERS_TABLE_NAME=cloudberry-real-estate-developers
REAL_ESTATE_AREAS_TABLE_NAME=cloudberry-real-estate-communities
PROJECTS_TABLE_NAME=cloudberry-real-estate-projects

# S3 bucket for documents and media
S3_BUCKET_NAME=your-s3-bucket-name

# Admin auth (global fallback admin in core table)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-secret

# AI Calling Service Internal API (Optional)
# API key for authenticating requests from AI Calling Lambda
AI_CALLING_INTERNAL_API_KEY=your-internal-api-key-here
