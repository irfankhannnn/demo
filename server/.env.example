# Backend server
PORT=3001
AWS_REGION=ap-south-1
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.realestateflow.in

# DynamoDB tables (see CloudFormation outputs)
DYNAMODB_TABLE_NAME=real-estate-core
CRM_DYNAMODB_TABLE_NAME=real-estate-crm
AGENCY_CONFIG_DYNAMODB_TABLE_NAME=real-estate-agencies
ENQUIRIES_DYNAMODB_TABLE_NAME=real-estate-enquiries
AREAS_DYNAMODB_TABLE_NAME=real-estate-areas
B2B_LEADS_TABLE=cloudberry-real-estate-b2b-details
KHATA_TABLE_NAME=cloudberry-real-estate-khata
NOTIFICATIONS_TABLE_NAME=cloudberry-real-estate-notifications

# Real Estate Management Tables (Developers, Areas, Projects)
DEVELOPERS_TABLE_NAME=cloudberry-real-estate-developers
REAL_ESTATE_AREAS_TABLE_NAME=cloudberry-real-estate-communities
PROJECTS_TABLE_NAME=cloudberry-real-estate-projects

# S3 bucket for documents and media
S3_BUCKET_NAME=your-s3-bucket-name

# Local DynamoDB endpoint (leave blank in prod — uses AWS default)
DYNAMODB_ENDPOINT=

# CRM single-table name + API base paths
CRM_TABLE=real-estate-crm
CRM_API_BASE_PATH=/api
PUBLIC_API_BASE_PATH=/public

# Auth microservice URL (local dev or deployed API Gateway)
AUTH_SERVICE_URL=http://localhost:3002

# Internal API key for service-to-service calls
INTERNAL_API_KEY=your-internal-api-key-here

# AI Calling Service Internal API (Optional)
AI_CALLING_INTERNAL_API_KEY=your-internal-api-key-here

# Billing & Razorpay (LIVE keys from Razorpay Dashboard after KYC activation)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_AI_EMPLOYEE=plan_test_ai_employee

# Trial length (days) — defaults to 14 if unset
TRIAL_DAYS=14

# Brevo (email)
BREVO_API_KEY=your-brevo-api-key
BREVO_TRIAL_LIST_ID=1
BREVO_AI_EMPLOYEE_PAID_TEMPLATE_ID=1
BREVO_AI_EMPLOYEE_ESCALATED_FOUNDER_TEMPLATE_ID=2
BREVO_AI_EMPLOYEE_ESCALATED_CUSTOMER_TEMPLATE_ID=3
BREVO_FROM_EMAIL=no-reply@realestateflow.in
BREVO_FROM_NAME=RealEstateFlow
BREVO_SENDER_EMAIL=noreply@realestateflow.in

# Founder notifications
FOUNDER_EMAIL=info@realestateflow.in
FOUNDER_NOTIFICATION_EMAIL=info@realestateflow.in
FOUNDER_WHATSAPP=+91XXXXXXXXXX

# AiSensy (WhatsApp)
AISENSY_API_KEY=your-aisensy-api-key

# hCaptcha
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret

# Grievance Officer (DPDP) — contact + abuse rate limiting
GRIEVANCE_OFFICER_EMAIL=info@realestateflow.in
GRIEVANCE_RATE_LIMIT_MAX=5
GRIEVANCE_RATE_LIMIT_WINDOW_MS=3600000

# PostHog
POSTHOG_KEY_SERVER=your-posthog-server-key
POSTHOG_HOST=https://eu.i.posthog.com

# Analytics / Operational tables
SUBSCRIPTIONS_TABLE=Subscriptions
NPS_TABLE=NPSResponses
NPS_HMAC_SECRET=your-nps-hmac-secret
WEBHOOK_LOG_TABLE=WebhookLog
AI_EMPLOYEE_PROVISIONING_TABLE=AIEmployeeProvisioning
TENANT_API_KEYS_TABLE=TenantApiKeys
GRIEVANCES_TABLE_NAME=Grievances

# Demo environment
DEMO_TENANT_ID=DEMO_REALESTATEFLOW

# Sentry (server error tracking — set SENTRY_DSN_SERVER to enable; leave blank = no-op)
SENTRY_DSN_SERVER=
SENTRY_ENV=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Legacy alias (some tooling reads SENTRY_DSN directly)
SENTRY_DSN=

# Credits (E2)
CREDITS_TABLE_NAME=cloudberry-real-estate-credits
CREDIT_CONFIG_TABLE_NAME=cloudberry-real-estate-credit-config

# Email SES (E3)
AWS_SES_FROM_EMAIL=noreply@realestateflow.in
EMAIL_PROVIDER_PRIMARY=ses
EMAIL_PROVIDER_FALLBACK=brevo

# Bailey WhatsApp (E1, optional)
BAILEY_ENABLED=false
BAILEY_API_KEY=
BAILEY_WEBHOOK_SECRET=
BAILEY_API_ENDPOINT=https://api.bailey.ai

# Agents (E6)
AGENTS_ENABLED=false

# Logging
LOG_LEVEL=info
