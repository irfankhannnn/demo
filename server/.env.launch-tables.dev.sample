# =============================================================================
# RealEstateFlow Launch Tables — dev environment
# Copy to .env.launch-tables.dev and fill in real values.
#
# Consumed by infra/deploy-launch-tables.sh dev, which deploys
# infra/launch-tables-cfn.yaml as its own stack (dev-realestateflow-launch-tables).
# This is separate from .env.dev (which is for cfn-backend.yaml) because the
# two templates own completely different resources and deploy independently.
# =============================================================================

AWS_REGION=ap-south-1

# Created by cfn-templates-cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment. Used here only to archive a
# copy of launch-tables-cfn.yaml for build tracking (this stack has no
# Lambda code, so there's nothing else to upload).
ARTIFACT_BUCKET=dev-realestateflow-artifacts
