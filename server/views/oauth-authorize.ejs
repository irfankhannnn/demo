<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Authorize RealtyFlow</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      max-width: 500px;
      width: 100%;
    }

    .card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px 20px;
      text-align: center;
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 10px;
      letter-spacing: -0.5px;
    }

    .tagline {
      font-size: 14px;
      opacity: 0.9;
      font-weight: 400;
    }

    .content {
      padding: 30px 20px;
    }

    .client-info {
      background: #f8f9fa;
      border-left: 4px solid #667eea;
      padding: 15px;
      border-radius: 6px;
      margin-bottom: 25px;
    }

    .client-name {
      font-size: 18px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 5px;
    }

    .client-description {
      font-size: 14px;
      color: #666;
      line-height: 1.5;
    }

    .permissions-section {
      margin-bottom: 25px;
    }

    .permissions-title {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .permissions-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .permission-item {
      display: flex;
      align-items: center;
      font-size: 14px;
      color: #333;
      padding: 8px 0;
    }

    .permission-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      background: #e8f5e9;
      border-radius: 50%;
      margin-right: 10px;
      color: #4caf50;
      font-size: 12px;
      font-weight: bold;
    }

    .user-info {
      background: #f0f4ff;
      padding: 15px;
      border-radius: 6px;
      margin-bottom: 25px;
      font-size: 13px;
      color: #333;
    }

    .user-info-label {
      color: #666;
      font-weight: 500;
      margin-bottom: 4px;
    }

    .user-name {
      font-weight: 600;
      color: #1a1a1a;
    }

    .user-email {
      color: #666;
      font-size: 12px;
      margin-top: 4px;
    }

    .buttons {
      display: flex;
      gap: 12px;
      margin-top: 30px;
    }

    .btn {
      flex: 1;
      padding: 12px 20px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-deny {
      background: #f5f5f5;
      color: #333;
      border: 1px solid #ddd;
    }

    .btn-deny:hover {
      background: #efefef;
      border-color: #ccc;
    }

    .btn-allow {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-allow:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }

    .btn:active {
      transform: translateY(0);
    }

    .footer {
      padding: 15px 20px;
      background: #f8f9fa;
      border-top: 1px solid #eee;
      text-align: center;
      font-size: 12px;
      color: #999;
    }

    .footer a {
      color: #667eea;
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }

    @media (max-width: 480px) {
      .container {
        padding: 0;
      }

      .card {
        border-radius: 0;
      }

      .header {
        padding: 25px 15px;
      }

      .content {
        padding: 25px 15px;
      }

      .buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <div class="logo">RealtyFlow</div>
        <div class="tagline">Real Estate CRM for Indian Agencies</div>
      </div>

      <div class="content">
        <div class="client-info">
          <div class="client-name"><%= client_name %> wants to access your RealtyFlow CRM</div>
          <div class="client-description">
            This will allow <%= client_name %> to read and manage your leads, properties, owners, tenants, buyers, and meetings.
          </div>
        </div>

        <div class="permissions-section">
          <div class="permissions-title">Permissions Requested</div>
          <div class="permissions-list">
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>Read and list leads</span>
            </div>
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>Create and update leads</span>
            </div>
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>Read and manage properties</span>
            </div>
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>Read and manage owners, tenants, and buyers</span>
            </div>
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>Create and manage meetings</span>
            </div>
            <div class="permission-item">
              <div class="permission-icon">✓</div>
              <span>View CRM metrics and statistics</span>
            </div>
          </div>
        </div>

        <div class="user-info">
          <div class="user-info-label">You're logged in as:</div>
          <div class="user-name"><%= user.name %></div>
          <div class="user-email"><%= user.email %></div>
        </div>

        <form method="POST" action="/oauth/authorize">
          <input type="hidden" name="client_id" value="<%= client_id %>">
          <input type="hidden" name="redirect_uri" value="<%= redirect_uri %>">
          <input type="hidden" name="state" value="<%= state %>">

          <div class="buttons">
            <button type="submit" name="action" value="deny" class="btn btn-deny">Deny</button>
            <button type="submit" name="action" value="allow" class="btn btn-allow">Allow Access</button>
          </div>
        </form>
      </div>

      <div class="footer">
        <p>
          By authorizing, you agree to RealtyFlow's
          <a href="https://realtyflow.com/terms" target="_blank">Terms of Service</a> and
          <a href="https://realtyflow.com/privacy" target="_blank">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>
