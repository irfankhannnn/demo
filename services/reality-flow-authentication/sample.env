# ============================================================
# Reality Flow Authentication Microservice - Environment Config
# ============================================================
# Copy to .env for local dev, or .env.dev / .env.prod for
# infra/deploy.sh (./infra/deploy.sh dev | ./infra/deploy.sh prod).
#
# Every physical AWS resource cfn-backend.yaml creates is named
# <dev|prod>-realestateflow-auth-<resource> (ENV-SERVICE_NAME-resource, env
# first) — keep SERVICE_NAME set to realestateflow-auth when filling this in.

# --- AWS Region ---
AWS_REGION=ap-south-1

# --- Stack / Service ---
# ENV is NOT read from this file by deploy.sh — it's forced from the
# dev|prod argument you pass on the command line, so it can't drift.
SERVICE_NAME=realestateflow-auth

# --- Cognito (V2 pool supporting both Google and Phone auth) ---
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN_PREFIX_V2=dev-realestateflow-auth-v2
COGNITO_HOSTED_UI_DOMAIN=https://dev-realestateflow-auth-v2.auth.ap-south-1.amazoncognito.com

# --- Google OAuth (from Google Developer Console) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- DynamoDB Tables ---
USERS_TABLE=dev-realestateflow-auth-users
AUTH_IDENTITIES_TABLE=dev-realestateflow-auth-auth-identities
# server's AgencyConfigTable is the single source of truth for agency config
# (shared with the CRM/agent server) — see .env.dev's fuller comment.
AGENCY_CONFIG_TABLE=dev-realestateflow-agencies
OTP_TABLE=dev-realestateflow-auth-otp
# Created by apps/crm/server/infra/launch-tables-cfn.yaml, not this stack — must
# match what that stack names it for the same environment.
SUBSCRIPTIONS_TABLE=dev-realestateflow-subscriptions
# Leave blank until the server stack (dev-realestateflow-backend /
# prod-realestateflow-backend) has been deployed at least once — setting
# this before its SubscriptionsTableName export exists fails the deploy.
# Since auth deploys FIRST, this stays blank on auth's first deploy.
SERVER_STACK_NAME=

# --- Lambda Deployment ---
# Created by infra/cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment for both Lambda code and
# oversized/nested CFN templates. Must match <env>-realestateflow-artifacts
# for the same environment.
LAMBDA_PACKAGES_BUCKET_NAME=dev-realestateflow-artifacts
LAMBDA_MEMORY_SIZE=256
LAMBDA_TIMEOUT=30
LOG_RETENTION_IN_DAYS=14

# --- Networking (optional, leave empty if Lambda doesn't need VPC) ---
SUBNET_IDS=
SECURITY_GROUP_IDS=

# --- Domain (optional, for custom domain on API Gateway) ---
DOMAIN_NAME=

# --- Custom domain / API Gateway base path mapping ---
# services-api.realestateflow.in is prod-only; services-api.cloudberrysolutions.in
# is dev/nonprod-only — never point one environment's file at the other's domain.
# Bare host only (no https://) and never a raw *.execute-api.*.amazonaws.com
# host — infra/deploy.sh refuses both, and refuses an empty base path.
# Base path: devrealestateauth (dev) / prodrealestateauth (prod).
AUTH_API_DOMAIN_NAME=services-api.example.com
AUTH_API_BASE_PATH=devrealestateauth
# Both domains already exist as AWS::ApiGateway::DomainName, so .env.dev and
# .env.prod set both flags true. Keep them in lockstep: mapping on + strip off
# means the Lambda sees /devrealestateauth/... and every route 404s.
ENABLE_CUSTOM_DOMAIN_MAPPING=true
ENABLE_BASE_PATH_STRIP=true

# --- Dev/Testing OTP Override ---
# Set TEST_OTP_ENABLED=true to skip SMS and use a fixed OTP during development
TEST_OTP_ENABLED=false
TEST_OTP_VALUE=123456

# --- Local Dev ---
PORT=3002

# --- Callback URL (frontend redirect after Cognito auth) ---
IDENTITY_CALLBACK_URL=http://localhost:3000/auth/callback
IDENTITY_LOGOUT_URL=http://localhost:3000/logout

# --- Invite emails ---
# Leave AWS_SES_FROM_EMAIL blank if no verified SES sender identity exists
# yet in this environment/account — invite creation still succeeds, the
# email send is just skipped (logged as a warning). See
# src/utils/emailService.ts and src/controllers/inviteController.ts.
AWS_SES_FROM_EMAIL=info@realestateflow.in
FRONTEND_LOGIN_URL=http://localhost:3000/login
