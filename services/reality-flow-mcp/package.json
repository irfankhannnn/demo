{
  "name": "reality-flow-mcp",
  "version": "1.0.0",
  "description": "MCP (Model Context Protocol) microservice for RealtyFlow CRM \u2014 exposes CRM tools to Claude, ChatGPT, and other AI apps",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-views",
    "copy-views": "node -e \"require('fs').cpSync('src/views','dist/views',{recursive:true})\"",
    "dev": "ts-node src/local-server.ts",
    "start": "node dist/local-server.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "deploy": "bash infra/deploy.sh",
    "generate:tools": "node ../../apps/crm/server/scripts/generate-mcp-tools.mjs",
    "check:tools": "node ../../apps/crm/server/scripts/generate-mcp-tools.mjs --check",
    "check:scopes": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} scripts/check-scopes.ts",
    "prebuild": "npm run generate:tools && npm run check:scopes"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@codegenie/serverless-express": "^4.12.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
