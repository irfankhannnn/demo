# =============================================================================
# WhatsApp Platform — Environment Template
#
# Copy to .env for local development (LOCAL_STORAGE=true, no AWS involved).
#
# For an actual ECS deploy, copy to .env.<env> — infra/deploy.sh (and the
# infra/cicd/platform/whatsapp-platform CI/CD wrapper that delegates to it)
# loads .env.dev / .env.staging / .env.prod by the environment argument, and
# refuses to deploy an env with no matching file. All files use the same
# keys; only values change per environment. Real per-env files are
# gitignored (see .gitignore) — this sample is the only one committed.
# =============================================================================

# --- Server ---
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# --- Storage mode ---
LOCAL_STORAGE=true

# --- Auth / API keys ---
BAILEYS_API_KEY=change-me-to-a-long-random-string
BAILEYS_ADMIN_API_KEY=change-me-to-a-different-long-random-string
BAILEYS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- CRM integration ---
CRM_WEBHOOK_URL=http://localhost:4000/api/webhooks/whatsapp
CRM_WEBHOOK_SECRET=

# --- Local filesystem storage ---
AUTH_STATE_DIR=./auth_state
AUTH_BACKUP_DIR=./auth-backups
AUTH_ENCRYPTION_KEY=change-me-to-32-plus-char-random-string

# --- Session defaults ---
DEFAULT_SESSION_PHONE=
BROWSER_NAME=Chrome

# --- AWS (required when LOCAL_STORAGE=false) ---
AWS_REGION=ap-south-1
SESSION_BUCKET_NAME=
SESSION_KMS_KEY_ID=
SESSION_TABLE_NAME=dev-whatsapp-sessions

# --- AWS infrastructure (ECS deployment) ---
AWS_VPC_ID=vpc-xxxxxxxx
AWS_VPC_CIDR=10.0.0.0/16
AWS_PRIVATE_SUBNET_IDS=subnet-aaaaaaaa,subnet-bbbbbbbb,subnet-cccccccc

# --- EventBridge ---
USE_EVENTBRIDGE=false
EVENT_BUS_NAME=default

# --- CloudWatch metrics ---
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=WhatsAppPlatform

# --- ECS task metadata ---
ECS_TASK_ID=local
ECS_TASK_ARN=
MAX_SESSIONS_PER_TASK=100
RESTORE_ON_STARTUP=true

# --- ECS task configuration (deploy.sh) ---
DESIRED_COUNT=
TASK_CPU=
TASK_MEMORY=

# --- Direct ingress ---
DIRECT_INGRESS_CIDR=0.0.0.0/0

# --- Route53 dynamic DNS (optional) ---
HOSTED_ZONE_ID=
DOMAIN_NAME=

# --- Fargate Spot ---
SPOT_CAPACITY=true

# --- CloudWatch alarms ---
ALARM_EMAIL=
LOG_RETENTION_DAYS=30

# --- Baileys tuning ---
QR_TIMEOUT_MS=60000
SEND_MESSAGE_TIMEOUT_MS=30000
MESSAGE_DEBOUNCE_MS=0
HEALTH_PROBE_INTERVAL_MS=30000
HEALTH_PROBE_TIMEOUT_MS=10000
DEFAULT_QUERY_TIMEOUT_MS=60000
PREKEY_ROTATION_INTERVAL_MS=21600000
SOFT_RESET_MAX_RETRIES=2

# --- AI self-chat triggers ---
AI_SELF_CHAT_TRIGGERS="AI:,Bot:,Hey bot"
