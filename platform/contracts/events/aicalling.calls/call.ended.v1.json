{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.realestateflow.in/events/aicalling.calls/call.ended.v1.json",
  "title": "call.ended",
  "description": "An AI call finished. The same callSessionId may be published more than once (carrier status, then the transcript a few seconds later); the later event carries more data. Consumers dedupe on callSessionId. Every field is present even when null.",
  "x-source": "aicalling.calls",
  "x-detail-type": "call.ended",
  "x-producer": "agency-app/ai-calling (src/services/eventPublisher.js buildCallEndedDetail)",
  "x-consumers": ["agency-app/followup-agent worker"],
  "type": "object",
  "required": ["tenantId", "callSessionId", "status", "endedAt"],
  "properties": {
    "tenantId": { "type": "string" },
    "callSessionId": { "type": "string" },
    "leadId": { "type": ["string", "null"] },
    "callPurpose": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "outcome": { "type": ["string", "null"] },
    "duration": { "type": "number", "description": "Seconds; 0 when unknown" },
    "followupJobId": { "type": ["string", "null"] },
    "needsHuman": { "type": "boolean" },
    "needsHumanReason": { "type": ["string", "null"] },
    "feedback": { "type": ["object", "string", "null"] },
    "meeting": { "type": ["object", "null"] },
    "transcriptSummary": { "type": ["string", "null"] },
    "dataCollection": { "type": ["object", "null"], "description": "ElevenLabs analysis.data_collection_results" },
    "source": { "type": ["string", "null"], "enum": ["elevenlabs_post_call", "exotel_status", "initiation", null] },
    "endedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
