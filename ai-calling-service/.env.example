# AI Calling Service — environment reference.
#
# Copy to .env.dev / .env.prod (both gitignored) and fill in. Never commit a
# filled copy. infra/deploy.sh reads .env.<env> and refuses to run if anything
# required is missing, so a half-filled file fails loudly rather than deploying
# a broken stack.
#
# Legend:
#   [SECRET]   real credential — get it from the named dashboard, never invent one
#   [DEPLOY]   supplied at deploy time from this file; the running app reads it
#              from the Lambda environment, never from here
#   [DEFAULT]  safe to leave as-is

# =============================================================================
# AWS / deploy target                                                  [DEPLOY]
# =============================================================================

AWS_REGION=ap-south-1

# dev  -> cloudberry-main       (account 730335176275)
# prod -> cloudberry-prod-new   (account 532404260898)
# deploy.sh prints the resolved account before doing anything.
AWS_PROFILE=cloudberry-main

# Env-first naming: <env>-realestateflow-<service>-<resource>. deploy.sh hard
# fails if these don't start with the right prefix for the environment.
STACK_NAME=dev-realestateflow-aicalling-stack

# One shared artifact bucket per environment, holding Lambda code AND templates.
ARTIFACT_BUCKET=dev-realestateflow-artifacts
ARTIFACT_PREFIX=aicalling

# =============================================================================
# Physical resource names                                              [DEPLOY]
# =============================================================================

AI_CALLING_TABLE_NAME=dev-realestateflow-aicalling-data
AI_CALLING_KNOWLEDGE_BUCKET=dev-realestateflow-aicalling-knowledge
AI_CALLING_RECORDINGS_BUCKET=dev-realestateflow-aicalling-recordings

# =============================================================================
# CRM integration
# =============================================================================

# The CRM's internal API — lead context, property lookups, writing call
# outcomes back onto the lead.
CRM_INTERNAL_API_URL=https://services-api.cloudberrysolutions.in/devrealestatecrm

# [SECRET] Shared secret presented as x-api-key. MUST equal the value of
# AI_CALLING_INTERNAL_API_KEY in server/.env.<env> (the CRM template's
# AiCallingInternalApiKey parameter) — a mismatch 401s every CRM lookup.
CRM_INTERNAL_API_KEY=

# =============================================================================
# Exotel — India telephony
# =============================================================================

# [DEFAULT] Region-specific for some accounts; api.exotel.com covers most.
EXOTEL_SUBDOMAIN=api.exotel.com

# [SECRET] Exotel dashboard -> Settings -> API credentials.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# [SECRET] Exotel account SID (the account identifier, e.g. "cloudberry1").
EXOTEL_SID=

# [DEPLOY] Comma-separated allowlist of Exotel's webhook source IPs. Values come
# from Exotel's documented webhook IP ranges — look them up in Exotel's own docs
# and paste them here; do not guess. Exotel does not sign its webhooks, so this
# source-IP check is the only thing distinguishing a real call-status event from
# a forged one.
#
# Validation fails CLOSED in prod and warns-but-allows in non-prod: blank is
# survivable in dev, but in prod it rejects every Exotel webhook, so calls never
# progress past "ringing". deploy.sh refuses a prod deploy while this is blank.
EXOTEL_WEBHOOK_IPS=

# =============================================================================
# ElevenLabs — the agent that actually talks to the customer
# =============================================================================

# [SECRET] ElevenLabs dashboard -> Developers -> API keys.
ELEVENLABS_API_KEY=

# ONE shared Conversational AI agent serves every tenant — per-agency
# personalisation is passed as dynamic variables at call start, not by creating
# an agent per agency. Copy the id from the agent's page.
ELEVENLABS_AGENT_ID=

# ElevenLabs' id for the imported Exotel ExoPhone. This is what bridges call
# audio to the agent in POST /v1/convai/exotel/outbound-call. Found under
# Phone Numbers after importing the ExoPhone. Without it, no call has audio.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# [SECRET] HMAC signing secret for post-call webhooks. /webhooks/* is publicly
# reachable, so this signature is the only thing separating a real ElevenLabs
# event from a forged one. Shown once when the webhook is created.
ELEVENLABS_WEBHOOK_SECRET=

# [SECRET] Bearer token the agent presents when calling this service's
# server-tool endpoints mid-conversation (property search, site-visit booking).
# Generate your own — `openssl rand -hex 32` — and set the same value as the
# tool's secret header in the ElevenLabs dashboard.
SERVER_TOOL_API_KEY=

# =============================================================================
# Public URL ElevenLabs calls back into
# =============================================================================

# Blank on the very first deploy — the API doesn't exist yet. After that deploy,
# copy the stack's ApiEndpoint (or CustomApiUrl once the domain mapping is on)
# into this and deploy again. deploy.sh reminds you if it's still blank.
WEBHOOK_BASE_URL=

# =============================================================================
# API surface
# =============================================================================

# [DEFAULT]
API_STAGE_NAME=v1

# Comma-separated CORS allowlist for the CRM frontend. The first entry is also
# used for API Gateway's own 4XX/5XX responses, which accept a single origin.
ALLOWED_ORIGINS=http://localhost:3000,https://app.realestateflow.in

# Shared API Gateway custom domain. prod MUST be services-api.realestateflow.in
# and dev MUST be services-api.cloudberrysolutions.in — deploy.sh rejects the
# reverse. Leave blank to stay on the raw execute-api URL.
AI_CALLING_API_DOMAIN_NAME=services-api.cloudberrysolutions.in

# Single base path segment on that domain.
AI_CALLING_API_BASE_PATH=devrealestateagencyai

# Keep false until the AWS::ApiGateway::DomainName above actually exists.
ENABLE_CUSTOM_DOMAIN_MAPPING=false

# Must be true whenever ENABLE_CUSTOM_DOMAIN_MAPPING is true. API Gateway does
# not strip the base path from a Lambda proxy event, so lambda-handler.js does
# it. Without this, every request 404s once the mapping goes live.
ENABLE_BASE_PATH_STRIP=false

# =============================================================================
# Bedrock RAG (FAQ / policy documents)
# =============================================================================

# Blank disables the RAG path entirely and drops the Bedrock IAM grant with it.
BEDROCK_KNOWLEDGE_BASE_ID=

# =============================================================================
# Lambda tuning                                              [DEPLOY] [DEFAULT]
# =============================================================================

# nodejs20.x preinstalls the full AWS SDK v3 client set this service needs.
# nodejs22.x does not — don't switch without bundling the missing clients.
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=30

# =============================================================================
# Operations                                                          [DEFAULT]
# =============================================================================

# debug | info | warn | error. Transcripts can surface in logs at debug.
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# How long call recordings are kept in S3 before deletion.
RECORDING_RETENTION_DAYS=90

# =============================================================================
# Local development only — ignored under Lambda
# =============================================================================

PORT=3002
