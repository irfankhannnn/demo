# AI Calling Service Environment Configuration

# AWS Region
AWS_REGION=ap-south-1

# DynamoDB Tables (AI Calling specific)
AI_CALLING_TABLE_NAME=ai-calling-data
AI_CALLING_KNOWLEDGE_BUCKET=ai-calling-knowledge

# Internal CRM API (for fetching lead/property data)
CRM_INTERNAL_API_URL=https://your-crm-api.execute-api.ap-south-1.amazonaws.com/prod
CRM_INTERNAL_API_KEY=your-internal-api-key

# Exotel Configuration (India Telephony)
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SID=your-exotel-sid
EXOTEL_SUBDOMAIN=your-exotel-subdomain

# ElevenLabs Configuration (AI Voice)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id

# Bedrock Knowledge Base (RAG)
BEDROCK_KNOWLEDGE_BASE_ID=your-kb-id

# Webhook Base URL (for Exotel callbacks)
WEBHOOK_BASE_URL=https://your-ai-calling-api.execute-api.ap-south-1.amazonaws.com/prod

# Feature Flags
ENABLE_CALL_RECORDING=true
ENABLE_TRANSCRIPT_STORAGE=true
MAX_CALL_DURATION_SECONDS=600

# Local Development
PORT=3002
