{
  "name": "ai-calling-service",
  "version": "1.0.0",
  "description": "AI Calling Agent Service for Real Estate CRM - Exotel + ElevenLabs integration",
  "type": "module",
  "main": "src/lambda-handler.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
