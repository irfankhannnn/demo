# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
# A plain ".env" line does NOT match ".env.dev"/".env.prod", so both patterns
# are required, with an explicit exception for the committed sample template.
# These files carry the real Exotel / ElevenLabs / CRM credentials that
# infra/deploy.sh feeds into Secrets Manager.
.env
.env.*
!.env.example

# Build artifacts regenerated fresh by infra/deploy.sh on every run. Both carry
# real secret values pulled from .env.<env>, so neither is ever committed.
infra/cfn-params.json
infra/.last-deploy-artifacts.json

# Local CI/CD build/release index (S3 is the durable source of truth).
deploy-versions/
