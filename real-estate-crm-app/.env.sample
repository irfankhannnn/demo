# =============================================================================
# RealtyFlow CRM Frontend — Environment Template
# Copy to .env for local development or .env.production for production builds.
# All three files must use the same keys; only values change per environment.
# =============================================================================

# --- App ---
VITE_APP_TITLE=RealEstateFlow
VITE_PORT=3000

# --- CRM API ---
VITE_API_URL=http://localhost:3001/api
VITE_API_BASE_URL=http://localhost:3001/api

# --- Tenant (local dev fallback only; production resolves from user profile) ---
VITE_TENANT_ID=your_tenant_id_here

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Authentication ---
VITE_AUTH_API_URL=http://localhost:3002
VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_cognito_client_id_here
VITE_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_AUTH_LOGOUT_URI=http://localhost:3000/login

# --- Analytics (PostHog) ---
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Billing (Razorpay) ---
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# --- Public forms ---
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
VITE_GRIEVANCE_OFFICER_NAME=Grievance Officer

# --- Feature flags ---
VITE_AI_CALLING_ENABLED=false
VITE_AI_CALLING_API_URL=
VITE_BAILEY_ENABLED=true
VITE_IS_DEMO=false

# --- Error monitoring (optional) ---
VITE_SENTRY_DSN=
