# =============================================================================
# RealtyFlow CRM Frontend — dev environment
# Copy to .env.dev and fill in real values.
#
# This file is read by TWO things:
#   1. `vite build --mode dev` (VITE_* keys) — see infra/deploy.sh
#   2. `infra/deploy.sh dev` (AWS_REGION / SERVICE_NAME / FRONTEND_* keys)
#      for the S3 + CloudFront stack it deploys/updates.
#
# Every physical AWS resource cfn-frontend.yaml creates is named
# dev-realestateflow-crm-frontend-<resource> (ENV-SERVICE_NAME-resource, env
# first) — keep SERVICE_NAME set to realestateflow-crm-frontend.
# =============================================================================

# --- Deploy (infra/deploy.sh dev) ---
AWS_REGION=ap-south-1
# ENV is NOT read from this file by deploy.sh — it's forced from the
# dev|prod argument you pass on the command line, so it can't drift.
SERVICE_NAME=realestateflow-crm-frontend
# Optional — leave blank to default to ${ENV}-${SERVICE_NAME}
# (dev-realestateflow-crm-frontend). Must be globally unique across all of S3.
FRONTEND_S3_BUCKET_NAME=
FRONTEND_PRICE_CLASS=PriceClass_200
# Optional custom domain — leave blank to use the *.cloudfront.net URL
FRONTEND_CUSTOM_DOMAIN_NAME=
# Required if FRONTEND_CUSTOM_DOMAIN_NAME is set. Must be an ACM cert in us-east-1.
FRONTEND_ACM_CERTIFICATE_ARN=
# Optional — only needed if you want deploy.sh to create the Route53 alias record
FRONTEND_HOSTED_ZONE_ID=
# Optional — AWS WAF WebACL ARN (scope CLOUDFRONT, us-east-1)
FRONTEND_WAF_WEB_ACL_ARN=
# Optional - wires up the /insta/* CloudFront behavior. Set to the
# InstaFrontendBucketRegionalDomainName output of the insta-frontend stack
# (step 1 of the 3-step deploy order in cfn-insta-frontend.yaml). Leave blank
# if the insta frontend does not need to be wired into this distribution.
INSTA_FRONTEND_BUCKET_DOMAIN_NAME=

# --- Build/release tracking (cfn-templates-cicd/real-estate-crm-app/deploy.sh) ---
# Created by cfn-templates-cicd/common-infra/vpc-networking.yaml (ArtifactBucket
# resource) — one shared bucket per environment for build archives (dist.tar.gz
# + CFN template snapshots), same bucket the Lambda services use for their code.
# Must match <env>-realestateflow-artifacts for the same environment.
ARTIFACT_BUCKET=dev-realestateflow-artifacts

# --- App ---
VITE_APP_TITLE="RealEstateFlow (Dev)"
VITE_PORT=3000

# --- CRM API ---
# Server CRM REST API. Bare custom-domain host + single-segment base path;
# the app appends /api itself (src/config/apiConfig.ts). Raw execute-api hosts are rejected.
VITE_CRM_API_DOMAIN_NAME=services-api.cloudberrysolutions.in
VITE_CRM_API_BASE_PATH=devrealestatecrm

# --- Tenant (local dev fallback only; production resolves from user profile) ---
VITE_TENANT_ID=your_tenant_id_here

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Authentication ---
VITE_AUTH_API_DOMAIN_NAME=services-api.cloudberrysolutions.in
VITE_AUTH_API_BASE_PATH=devrealestateauth
# reality-flow-mcp — optional. Blank = no MCP server in this env (the Claude
# Desktop setup snippet shows "not available"). The app appends /mcp itself.
VITE_MCP_API_DOMAIN_NAME=services-api.cloudberrysolutions.in
VITE_MCP_API_BASE_PATH=devrealestatemcp
VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_cognito_client_id_here
VITE_AUTH_REDIRECT_URI=https://your-dev-frontend-url/auth/callback
VITE_AUTH_LOGOUT_URI=https://your-dev-frontend-url/login

# --- Analytics (PostHog) ---
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Billing (Razorpay) ---
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# --- Public forms ---
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
VITE_GRIEVANCE_OFFICER_NAME="Grievance Officer"

# --- Feature flags ---
VITE_AI_CALLING_ENABLED=false
VITE_BAILEY_ENABLED=true
VITE_IS_DEMO=false

# --- Error monitoring (optional) ---
VITE_SENTRY_DSN=

# Support WhatsApp number, digits + country code (e.g. 919876543210).
# Support links are hidden when unset rather than rendering a dead link.
VITE_SUPPORT_WHATSAPP=

# Base URL of the hosted legal documents (privacy, terms, cookies, refund).
VITE_LEGAL_BASE_URL=https://realestateflow.in/legal

# Base URL of the property-pages-ms fallback path routing (serves
# <base>/t/<agency-slug>/... — see property-pages-ms/middleware/resolveTenant.js).
# Used to build the shareable public-listing link shown once a property is
# published. Leave blank in local dev to hide the shareable link instead of
# building a broken one.
# Dev CloudFront distribution for property-pages-ms. Once the wildcard DNS
# record exists this becomes https://pages.realestateflow.in and the CRM
# builds <base>/t/<slug>/... links against it either way.
VITE_PUBLIC_PAGES_BASE_URL=https://d6j8m980ctore.cloudfront.net
