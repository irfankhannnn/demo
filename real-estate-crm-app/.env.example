# ============================================
# API Configuration
# ============================================
# CRM API Gateway URL (requires authentication)
# Production: Use the CrmApiDomainName from CloudFormation with /api base path
# Example Production: https://crm-api.happyproperties.com/api
# Development: http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
VITE_API_BASE_URL=http://localhost:3001/api

# ============================================
# Tenant Configuration
# ============================================
# Unique tenant ID for multi-tenancy support
# Each organization gets their own tenant ID for data isolation
# Example: happy-properties, tenant-123, org-abc
VITE_TENANT_ID=your_tenant_id_here

# ============================================
# Google Maps API Configuration
# ============================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required for: Location picker, property map view, address autocomplete
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# Development Server Configuration
# ============================================
# Port for the Vite development server (optional, defaults to 8085)
VITE_PORT=8085

# ============================================
# AI Calling Module Configuration (Optional)
# ============================================
# Enable AI Calling feature (set to 'true' to enable)
VITE_AI_CALLING_ENABLED=true

# AI Calling Service API URL
# Example: https://your-ai-calling-api.execute-api.ap-south-1.amazonaws.com/prod
VITE_AI_CALLING_API_URL=
